{
  "name": "catmap-web",
  "version": "0.0.8",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --mode emulators --host 127.0.0.1",
    "dev:emulators": "vite --mode emulators --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "screens": "node tools/screens.mjs",
    "strings:check": "node tools/check-strings.mjs",
    "models:generate": "python tools/generate-models.py"
  },
  "dependencies": {
    "@fontsource/noto-sans-arabic": "5.3.0",
    "@fontsource/roboto": "5.3.0",
    "@mapbox/mapbox-gl-rtl-text": "1.0.0",
    "firebase": "13.0.0",
    "maplibre-gl": "6.15.0",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.4"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.0.5"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.5",
    "tinypool": "2.2.0"
  }
}
