{
  "name": "catmap-web",
  "version": "0.0.8",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --mode emulators --host 127.0.0.1",
    "dev:emulators": "vite --mode emulators --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "screens": "node tools/screens.mjs",
    "strings:check": "node tools/check-strings.mjs",
    "models:generate": "python tools/generate-models.py"
  },
  "dependencies": {
    "@fontsource/noto-sans-arabic": "5.3.0",
    "@fontsource/roboto": "5.3.0",
    "@mapbox/mapbox-gl-rtl-text": "0.3.0",
    "firebase": "12.19.0",
    "maplibre-gl": "6.11.2",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.4"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.0",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.3",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "5.0.2"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.5"
  }
}
