# Public Firebase Web app configuration. Keep actual values in .env.local.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_STORAGE_BUCKET=
# Keep false for the real site (a production build refuses true). `npm run dev` and `--mode emulators`
# switch to the local emulators on their own, with no real Firebase configuration needed.
VITE_USE_EMULATORS=false
# Optional local test database override; normal emulator port is 8080.
VITE_FIRESTORE_EMULATOR_PORT=8080
# Optional dedicated test suite; defaults match the normal shared demo.
VITE_AUTH_EMULATOR_PORT=9099
VITE_STORAGE_EMULATOR_PORT=9199
VITE_EMULATOR_PROJECT_ID=demo-catmap
# Optional satellite tiles; hides satellite control when blank.
VITE_MAPTILER_KEY=
# Paid-plan video feature; disabled by default.
VITE_BLAZE=false
# Public HTTPS origin used in shared links and poster QR codes.
VITE_PUBLIC_URL=
# Public GitHub repository for release notes.
VITE_GITHUB_REPO=yneager/CatMap-Dubai
