rules_version = '2';

// Security rules for CatMap Dubai.
// Roles live in users/{uid}.role: user, volunteer, moderator, admin.
// Writes require a verified email address; posting is rate limited per user.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------
    function signedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }
    // Suspended accounts (set by an admin) can still read, but every write that needs verified() is refused.
    // A missing profile makes get() fail, which refuses the write like exists() would, for less of the budget.
    function verified() { return signedIn() && request.auth.token.email_verified == true
      && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('suspended', false) != true
      && !exists(/databases/$(database)/documents/accountDeletions/$(request.auth.uid)); }
    function suspended() { return exists(userPath()) && get(userPath()).data.get('suspended', false) == true; }
    function userPath() { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function role() { return exists(userPath()) ? get(userPath()).data.role : 'user'; }
    function isVolunteer() { return signedIn() && role() in ['volunteer', 'moderator', 'admin']; }
    function isMod() { return signedIn() && role() in ['moderator', 'admin']; }
    function isAdmin() { return signedIn() && role() == 'admin'; }
    // The demo "admin" account carries this custom claim, set only by tools/demo/create-demo-accounts.mjs
    // (firebase auth:import). It lets that account give its own profile the admin role.
    function demoAdminClaim() { return signedIn() && request.auth.token.get('catmapAdmin', false) == true; }

    // Reads need a verified email (or the AI worker). Accounts made straight from the public API key without
    // verifying an address can't download the community's data. Suspended members can still read.
    function emailVerified() { return signedIn() && request.auth.token.email_verified == true; }
    function member() { return emailVerified() || aiWorker(); }

    // Client times are milliseconds. A time more than an hour ahead of the server would, for example, keep a post
    // at the top of everyone's feed, so it's refused.
    function notFuture(t) { return t is int && t >= 0 && t <= request.time.toMillis() + 3600000; }
    // Optional string / list field `k` of map `d`, at most `max` long.
    function optStr(d, k, max) { return !(k in d) || (d[k] is string && d[k].size() <= max); }
    function optList(d, k, max) { return !(k in d) || (d[k] is list && d[k].size() <= max); }
    function communityPhoto(id) { return id is string && !id.matches('c_.*'); }
    function communityPhotos(ids) { return ids is list && !ids.join(',').matches('(^|.*,)(c_[^,]*)(,.*|$)'); }

    // Map-area codes (data/Geohash.kt): the position's geohash at precision 4, 5 and 6, or none for a missing position.
    function geoCellsOk(d) {
      return !('geoCells' in d) || (d.geoCells is list && (d.geoCells.size() == 0
        || (d.geoCells.size() == 3 && d.geoCells[0] is string && d.geoCells[1] is string && d.geoCells[2] is string
            && d.geoCells.join(',').matches('[0-9b-hjkmnp-z]{4},[0-9b-hjkmnp-z]{5},[0-9b-hjkmnp-z]{6}'))));
    }

    // Search words and their first letters (data/SearchTerms.kt): at most 200, bounded in size.
    function searchTermsOk(d) {
      return !('searchTerms' in d) || (d.searchTerms is list && d.searchTerms.size() <= 200 && d.searchTerms.join(' ').size() <= 4000);
    }

    function incoming() { return request.resource.data; }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }
    function onlyChanging(fields) { return changed().hasOnly(fields); }
    function notChanging(fields) { return !changed().hasAny(fields); }

    // The client writes users/{uid}.lastPostAt = serverTimestamp() in the same batch as the post.
    // That proves the timestamp is fresh, and the previous value enforces a gap between posts.
    function rateLimited() {
      let before = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      let after = getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return after.lastPostAt == request.time
        && (before.get('lastPostAt', null) == null || request.time > before.lastPostAt + duration.value(10, 's'));
    }

    // ---------- users ----------
    function userFields() {
      return ['username', 'displayName', 'bio', 'photoId', 'role', 'volunteerStatus', 'stats', 'points', 'neighborhoods',
              'badges', 'followedCats', 'showStatsPublicly', 'suspended', 'lastPostAt', 'createdAt'];
    }
    function statKeys() {
      return ['sightings', 'catsRegistered', 'approvedSightings', 'photos', 'rescueReports', 'checkins', 'maintenanceReports',
              'mergeSuggestions', 'tnrReports', 'nightSightings', 'iftarCheckins', 'souqSightings', 'marinaSightings', 'posts',
              'reunited', 'postUpdates'];
    }
    // The app adds at most 6 to a counter in one write (the photos of one sighting). Written out key by key, without
    // helper calls: the rules may evaluate at most 1,000 expressions per document, and calls are the costly part.
    function statsDeltaOk(b, a) {
      let sd = a.diff(b).affectedKeys();
      return sd.size() <= 8 && sd.hasOnly(statKeys())
        && (!('sightings' in sd) || a.sightings - b.get('sightings', 0) <= 6)
        && (!('catsRegistered' in sd) || a.catsRegistered - b.get('catsRegistered', 0) <= 6)
        && (!('approvedSightings' in sd) || a.approvedSightings - b.get('approvedSightings', 0) <= 6)
        && (!('photos' in sd) || a.photos - b.get('photos', 0) <= 6)
        && (!('rescueReports' in sd) || a.rescueReports - b.get('rescueReports', 0) <= 6)
        && (!('checkins' in sd) || a.checkins - b.get('checkins', 0) <= 6)
        && (!('maintenanceReports' in sd) || a.maintenanceReports - b.get('maintenanceReports', 0) <= 6)
        && (!('mergeSuggestions' in sd) || a.mergeSuggestions - b.get('mergeSuggestions', 0) <= 6)
        && (!('tnrReports' in sd) || a.tnrReports - b.get('tnrReports', 0) <= 6)
        && (!('nightSightings' in sd) || a.nightSightings - b.get('nightSightings', 0) <= 6)
        && (!('iftarCheckins' in sd) || a.iftarCheckins - b.get('iftarCheckins', 0) <= 6)
        && (!('souqSightings' in sd) || a.souqSightings - b.get('souqSightings', 0) <= 6)
        && (!('marinaSightings' in sd) || a.marinaSightings - b.get('marinaSightings', 0) <= 6)
        && (!('posts' in sd) || a.posts - b.get('posts', 0) <= 6)
        && (!('reunited' in sd) || a.reunited - b.get('reunited', 0) <= 6)
        && (!('postUpdates' in sd) || a.postUpdates - b.get('postUpdates', 0) <= 6);
    }
    function statsStepOk(ch) {
      return !('stats' in ch) || (incoming().stats is map && statsDeltaOk(resource.data.get('stats', {}), incoming().stats));
    }
    // Largest single award: a sighting of a new cat with 6 photos (10 + 15 + 12 = 37). Largest loss: a deleted sighting (10).
    function pointsStepOk(ch) {
      return !('points' in ch) || (incoming().points is int
        && incoming().points - resource.data.get('points', 0) >= -25
        && incoming().points - resource.data.get('points', 0) <= 40);
    }
    // Lists the app grows or shrinks by one entry at a time.
    function listStepOk(ch, k) {
      return !(k in ch) || (incoming()[k] is list
        && incoming()[k].size() <= resource.data.get(k, []).size() + 1
        && incoming()[k].size() >= resource.data.get(k, []).size() - 1
        && incoming()[k].size() <= 500);
    }
    // The badges a profile has earned, by the same thresholds as gamification/Badges.kt ('' where not earned).
    function earnedBadges(d) {
      let s = d.get('stats', {});
      return ['',
        s.get('sightings', 0) >= 1 ? 'first_whiskers' : '',
        s.get('souqSightings', 0) >= 5 ? 'souq_resident' : '',
        d.get('neighborhoods', []).size() >= 3 ? 'abra_rider' : '',
        s.get('marinaSightings', 0) >= 3 ? 'marina_watcher' : '',
        s.get('catsRegistered', 0) >= 5 ? 'majlis_host' : '',
        s.get('checkins', 0) >= 10 ? 'ehsan_hero' : '',
        s.get('iftarCheckins', 0) >= 1 ? 'iftar_feeder' : '',
        s.get('nightSightings', 0) >= 5 ? 'night_patrol' : '',
        s.get('rescueReports', 0) >= 3 ? 'ghaf_guardian' : '',
        s.get('maintenanceReports', 0) >= 3 ? 'falaj_keeper' : '',
        s.get('tnrReports', 0) >= 5 ? 'tnr_champion' : '',
        s.get('approvedSightings', 0) >= 10 ? 'pearl_diver' : '',
        s.get('photos', 0) >= 20 ? 'palm_photographer' : '',
        s.get('mergeSuggestions', 0) >= 3 ? 'merge_detective' : '',
        d.get('followedCats', []).size() >= 5 ? 'heart_of_dubai' : '',
        s.get('sightings', 0) >= 25 ? 'falcon_eye' : '',
        d.get('neighborhoods', []).size() >= 10 ? 'burj_explorer' : '',
        s.get('sightings', 0) >= 100 ? 'caravan_leader' : ''];
    }
    // Badges are never taken away, and a new one must be earned by the profile's own counters.
    function badgesOk(ch) {
      return !('badges' in ch) || (incoming().badges is list
        && incoming().badges.toSet().hasAll(resource.data.get('badges', []).toSet())
        && incoming().badges.toSet().difference(resource.data.get('badges', []).toSet()).hasOnly(earnedBadges(incoming())));
    }
    // What a member may change on their own profile. Role, suspension and createdAt are never theirs to change.
    function selfProfileUpdateOk() {
      let d = incoming();
      let ch = changed();
      return ch.hasOnly(['username', 'displayName', 'bio', 'photoId', 'volunteerStatus', 'stats', 'points', 'neighborhoods',
                         'badges', 'followedCats', 'showStatsPublicly', 'lastPostAt'])
        && (!('lastPostAt' in ch) || d.lastPostAt == request.time)
        && (!('volunteerStatus' in ch) || d.volunteerStatus == 'applied')
        && (!('username' in ch) || canonicalUsername(d.username, uid()))
        && (!('displayName' in ch) || optStr(d, 'displayName', 60))
        && (!('bio' in ch) || optStr(d, 'bio', 300))
        && (!('photoId' in ch) || (optStr(d, 'photoId', 128) && communityPhoto(d.get('photoId', ''))))
        && (!('showStatsPublicly' in ch) || d.showStatsPublicly is bool)
        && statsStepOk(ch) && pointsStepOk(ch) && badgesOk(ch) && listStepOk(ch, 'neighborhoods') && listStepOk(ch, 'followedCats');
    }

    function slotStep(bucket, id, delta) {
      let path = /databases/$(database)/documents/userLimits/$(uid());
      return getAfter(path).data[bucket] == get(path).data[bucket] + delta
        && getAfter(path).data[bucket + 'Source'] == id;
    }
    function slotSourceStep(bucket) {
      let d = incoming();
      let source = /databases/$(database)/documents/users/$(uid())/$(bucket)/$(d[bucket + 'Source']);
      return d[bucket] is int && d[bucket] >= 0 && d[bucket] <= 500
        && d[bucket + 'Source'] is string && d[bucket + 'Source'].size() <= 128
        && ((d[bucket] == resource.data[bucket] + 1 && !exists(source) && existsAfter(source))
          || (d[bucket] == resource.data[bucket] - 1 && exists(source) && !existsAfter(source)));
    }
    match /userLimits/{id} {
      allow read: if signedIn() && uid() == id;
      allow delete: if signedIn() && uid() == id && exists(/databases/$(database)/documents/accountDeletions/$(id));
      allow create: if signedIn() && uid() == id && !exists(userPath()) && existsAfter(userPath())
        && incoming().keys().hasOnly(['favorites','blocked','unreadCount']) && incoming().favorites == 0 && incoming().blocked == 0 && incoming().get('unreadCount', 0) == 0;
      allow update: if signedIn() && ((uid() == id && (
        (onlyChanging(['favorites','favoritesSource']) && slotSourceStep('favorites'))
        || (onlyChanging(['blocked','blockedSource']) && slotSourceStep('blocked'))))
        || (onlyChanging(['unreadCount','unreadChatId','unreadMessageId']) && unreadTotalStep(id)));
    }
    function unreadTotalStep(owner) {
      let chatPath = /databases/$(database)/documents/chats/$(incoming().unreadChatId);
      let before = get(chatPath).data;
      let after = getAfter(chatPath).data;
      let messagePath = /databases/$(database)/documents/chats/$(incoming().unreadChatId)/messages/$(incoming().get('unreadMessageId', ''));
      return incoming().unreadCount is int && incoming().unreadCount >= 0 && uid() in before.members && owner in before.members
        && ((owner != uid() && incoming().unreadCount == resource.data.get('unreadCount', 0) + 1
          && !exists(messagePath) && getAfter(messagePath).data.senderId == uid()
          && after.lastMessageId == incoming().unreadMessageId && after.unread[owner] == before.unread[owner] + 1)
        || (owner == uid() && before.unread[owner] > 0 && after.unread[owner] == 0
          && incoming().unreadCount == resource.data.get('unreadCount', 0) - before.unread[owner]));
    }

    function canonicalUsername(name, owner) {
      return name is string && name.matches('[A-Za-z0-9_.]{3,20}')
        && getAfter(/databases/$(database)/documents/usernames/$(name.lower())).data.uid == owner;
    }
    function areaNamesOk(names) {
      return names is list && names.size() <= 200 && names.join(',').size() <= 4000
        && names.join(',').matches('(|[a-z0-9_-]{1,64}(,[a-z0-9_-]{1,64})*)');
    }
    function privateShape(doc, d) {
      return (doc == 'account' && d.keys().hasOnly(['email', 'createdAt'])
          && d.email is string && d.email.size() <= 320 && d.email == request.auth.token.email && notFuture(d.createdAt))
        || (doc == 'areaFollow' && d.keys().hasOnly(['lat', 'lng', 'radiusKm', 'updatedAt'])
          && d.lat is number && d.lat >= -90 && d.lat <= 90 && d.lng is number && d.lng >= -180 && d.lng <= 180
          && d.radiusKm is number && d.radiusKm > 0 && d.radiusKm <= 100 && notFuture(d.updatedAt))
        || (doc == 'push' && d.keys().hasOnly(['tokens']) && d.tokens is list && d.tokens.size() <= 10
          && d.tokens.join(',').size() <= 5120 && d.tokens.join(',').matches('[A-Za-z0-9_:.,-]+'));
    }

    match /users/{userId} {
      // Verified members see public profiles (names, photos, badges); an unverified account sees only its own.
      allow get: if signedIn() && (uid() == userId || member());
      allow list: if member();
      allow create: if signedIn() && uid() == userId && !exists(/databases/$(database)/documents/accountDeletions/$(uid()))
        && incoming().keys().hasOnly(userFields())
        && (incoming().role == 'user' || (incoming().role == 'admin' && demoAdminClaim()))
        && incoming().volunteerStatus == 'none'
        && incoming().points == 0
        && incoming().get('suspended', false) == false
        && incoming().get('stats', {}).size() == 0
        && incoming().get('badges', []).size() == 0
        && incoming().get('neighborhoods', []).size() == 0
        && incoming().get('followedCats', []).size() == 0
        && incoming().get('lastPostAt', null) == null
        && canonicalUsername(incoming().username, userId)
        && optStr(incoming(), 'displayName', 60) && optStr(incoming(), 'bio', 300) && optStr(incoming(), 'photoId', 128)
        && communityPhoto(incoming().get('photoId', ''));
      // Only admins can change a role or suspend an account.
      allow update: if
        (signedIn() && uid() == userId && selfProfileUpdateOk())
        || (isMod() && notChanging(['role', 'volunteerStatus', 'lastPostAt', 'suspended']))
        || isAdmin()
        || (signedIn() && uid() == userId && demoAdminClaim() && onlyChanging(['role']) && incoming().role == 'admin');
      // A suspended member can't delete their profile: re-creating it would clear the suspension.
      allow delete: if (signedIn() && uid() == userId && (resource == null || resource.data.get('suspended', false) != true
        || exists(/databases/$(database)/documents/accountDeletions/$(uid())))) || isAdmin();

      // Email address and other account data only the owner may see.
      match /private/{doc} {
        allow read, delete: if signedIn() && uid() == userId;
        allow create, update: if signedIn() && uid() == userId && privateShape(doc, incoming())
          && (doc == 'account' || (verified() && exists(userPath())));
      }

      match /notificationReceipts/{id} {
        allow get: if signedIn() && (uid() == userId || resource == null || resource.data.fromUid == uid());
        allow list: if signedIn() && uid() == userId;
        allow create: if signedIn() && incoming().keys().hasOnly(['fromUid','sourceId','createdAt'])
          && incoming().fromUid == uid() && optStr(incoming(), 'sourceId', 300) && notFuture(incoming().createdAt)
          && !exists(/databases/$(database)/documents/users/$(userId)/notifications/$(id))
          && getAfter(/databases/$(database)/documents/users/$(userId)/notifications/$(id)).data.fromUid == uid()
          && getAfter(/databases/$(database)/documents/users/$(userId)/notifications/$(id)).data.createdAt == incoming().createdAt;
        allow delete: if signedIn() && uid() == userId && exists(/databases/$(database)/documents/accountDeletions/$(uid()));
      }
      match /notifications/{notificationId} {
        allow list, delete: if signedIn() && uid() == userId;
        // A sender may check only their own fixed event ID for idempotent creation.
        allow get: if signedIn() && (uid() == userId || resource == null || resource.data.fromUid == uid());
        allow update: if signedIn() && uid() == userId && onlyChanging(['read']) && incoming().read is bool;
        allow create: if exists(/databases/$(database)/documents/users/$(userId))
          && !exists(/databases/$(database)/documents/accountDeletions/$(userId))
          && receiptOk(userId, notificationId, incoming()) && notificationKey(incoming(), notificationId) && (
          (verified() && uid() == userId && validNotification(incoming())
            && (incoming().type == 'welcome' && incoming().params.user == get(userPath()).data.username
              || incoming().type == 'stale_post' && eventStale(incoming())
              || incoming().type == 'achievement' && incoming().params.badge in earnedBadges(get(userPath()).data)))
          // Into someone else's inbox: only the kinds of alert the sender's role sends, in the app's own shape.
          || (verified() && !aiWorker() && incoming().fromUid == uid() && validNotification(incoming())
              && incoming().read == false && notificationEvent(incoming(), userId)
              && exists(/databases/$(database)/documents/users/$(userId))
              && !exists(/databases/$(database)/documents/accountDeletions/$(userId))
              // Someone you blocked can't reach your inbox either (their messages are already refused).
              && !exists(/databases/$(database)/documents/users/$(userId)/blocked/$(uid())))
          // The AI worker may only announce a match it found, once per match (fixed ids pm_/pr_ + match id).
          || (aiWorker() && incoming().fromUid == uid() && validNotification(incoming())
              && incoming().type in ['match_found', 'match_reporter']
              && incoming().get('sourceId', '') == notificationId[3:] && incoming().route == 'match/' + notificationId[3:]
              && (incoming().type == 'match_found'
                ? get(/databases/$(database)/documents/matches/$(incoming().sourceId)).data.lostOwnerId == userId
                : get(/databases/$(database)/documents/matches/$(incoming().sourceId)).data.sightingOwnerId == userId))
          || (maintenanceWorker() && incoming().fromUid == uid() && validNotification(incoming())
              && incoming().type == 'lost_nearby' && notificationId == 'lost_' + incoming().sourceId
              && incoming().route == 'post/' + incoming().sourceId && postAt(incoming().sourceId).hidden == false
              && postAt(incoming().sourceId).status == 'open' && postAt(incoming().sourceId).category == 'lost'
              && incoming().params.name == postAt(incoming().sourceId).name
              && postAt(incoming().sourceId).neighborhood in get(/databases/$(database)/documents/areaFollows/$(userId)).data.neighborhoods
              && !exists(/databases/$(database)/documents/users/$(userId)/blocked/$(postAt(incoming().sourceId).ownerId))));
      }

      // Saved posts and blocked people are private to their owner.
      match /favorites/{postId} {
        allow read: if signedIn() && uid() == userId;
        allow delete: if signedIn() && uid() == userId && (exists(/databases/$(database)/documents/accountDeletions/$(uid())) || slotStep('favorites', postId, -1));
        allow create: if verified() && uid() == userId && exists(userPath())
          && postId.size() <= 128 && incoming().keys().hasOnly(['postId', 'savedAt'])
          && incoming().postId == postId && notFuture(incoming().savedAt) && slotStep('favorites', postId, 1);
      }
      match /blocked/{otherId} {
        allow read: if maintenanceWorker() || (signedIn() && uid() == userId);
        allow delete: if signedIn() && uid() == userId && (exists(/databases/$(database)/documents/accountDeletions/$(uid())) || slotStep('blocked', otherId, -1));
        allow create: if verified() && uid() == userId && exists(userPath()) && otherId != uid()
          && otherId.size() <= 128 && incoming().keys().hasOnly(['at']) && notFuture(incoming().at) && slotStep('blocked', otherId, 1);
      }
    }

    function receiptOk(recipient, id, n) {
      let path = /databases/$(database)/documents/users/$(recipient)/notificationReceipts/$(id);
      return !exists(path) && getAfter(path).data.fromUid == uid()
        && getAfter(path).data.sourceId == n.get('sourceId', '') && getAfter(path).data.createdAt == n.createdAt;
    }
    function notificationKey(n, id) {
      return n.type == 'message' ? id == 'msg_' + n.route[5:] + '_' + n.sourceId
        : n.type == 'post_update' ? id == 'upd_' + n.route[5:] + '_' + n.sourceId
        : n.type == 'match_found' ? id == 'pm_' + n.sourceId
        : n.type == 'match_reporter' ? id == 'pr_' + n.sourceId
        : n.type == 'match_info' ? id == 'mi_' + n.sourceId
        : n.type == 'match_reunited' ? id == 'ru_' + n.sourceId
        : n.type == 'welcome' ? id == 'welcome'
        : n.type == 'stale_post' ? id == 'stale_' + n.sourceId + '_' + string(int(request.time.toMillis() / 1209600000))
        : n.type == 'achievement' ? id == 'achievement_' + n.params.badge
        : n.type in ['adoption_request','adoption_decision','booking_request','booking_update','review','followed_cat','rescue_moderation','rescue_update']
          ? id == n.type + '_' + n.sourceId + '_' + n.params.get('status', n.params.get('decision', ''))
          : true;
    }

    // ---------- notification shape ----------
    // Alerts are formatted on the receiving phone from `type` and `params`, so these checks decide what a sender can
    // make someone else's phone say.
    function paramOk(m, k) { return !(k in m) || (m[k] is string && m[k].size() <= 300); }
    function validParams(m) {
      return m is map && m.size() <= 8
        && m.keys().hasOnly(['user', 'name', 'text', 'area', 'lostArea', 'matchId', 'type', 'category', 'kind', 'status', 'cat',
                             'station', 'decision', 'target', 'label', 'rating', 'badge', 'tier'])
        && paramOk(m, 'user') && paramOk(m, 'name') && paramOk(m, 'text') && paramOk(m, 'area') && paramOk(m, 'lostArea')
        && paramOk(m, 'matchId') && paramOk(m, 'type') && paramOk(m, 'category') && paramOk(m, 'kind') && paramOk(m, 'status')
        && paramOk(m, 'cat') && paramOk(m, 'station') && paramOk(m, 'decision') && paramOk(m, 'target') && paramOk(m, 'label')
        && paramOk(m, 'rating') && paramOk(m, 'badge') && paramOk(m, 'tier');
    }
    function validNotification(n) {
      return n.keys().hasOnly(['type', 'params', 'route', 'fromUid', 'read', 'createdAt', 'sourceId'])
        && optStr(n, 'sourceId', 300) && n.get('sourceId', '').matches('(|[A-Za-z0-9_.-]{1,300})') && n.read is bool
        && n.type is string && n.type.size() <= 40
        && validParams(n.get('params', {}))
        && n.get('route', '') is string
        && n.get('route', '').matches('(|(post|cat|sighting|rescue|station|sitter|user|match|chat)/[A-Za-z0-9][A-Za-z0-9_.-]{0,299}|adoption-requests|achievements|profile|bookings|bookings[?]tab=(sitter|owner))')
        && notFuture(n.createdAt);
    }
    // Alerts any member sends to another person (messages, matches, bookings, lost-pet alerts...). Moderation and
    // staff alerts need the role; welcome, achievement and stale-post reminders only ever go to your own inbox.
    function eventMessage(n, recipient) {
      let chatId = n.route[5:];
      let c = get(/databases/$(database)/documents/chats/$(chatId)).data;
      let m = get(/databases/$(database)/documents/chats/$(chatId)/messages/$(n.sourceId)).data;
      return n.route.matches('chat/.+') && uid() in c.members && recipient in c.members && m.senderId == uid()
        && n.params.user == get(userPath()).data.username
        && n.params.text == (m.text != '' ? m.text[0:(m.text.size() < 120 ? m.text.size() : 120)] : m.imageId != '' ? 'Photo' : 'Post: ' + m.postTitle);
    }
    function eventStale(n) {
      let p = postAt(n.sourceId);
      let cutoff = request.time.toMillis() - 1209600000;
      return n.route == 'post/' + n.sourceId && p.ownerId == uid() && p.hidden == false
        && p.status == 'open' && p.category in ['lost','found'] && n.params.name == p.name
        && p.createdAt > 0 && p.createdAt <= cutoff && p.updatedAt <= cutoff && p.get('lastActivityAt', 0) <= cutoff;
    }
    function eventAdoption(n, recipient) {
      let r = get(/databases/$(database)/documents/adoptionRequests/$(n.sourceId)).data;
      return n.params.name == r.postName && (n.type == 'adoption_request'
        ? r.requesterId == uid() && r.ownerId == recipient && n.params.user == get(userPath()).data.username && n.route == 'adoption-requests'
        : r.ownerId == uid() && r.requesterId == recipient && n.params.decision == r.status && r.status in ['approved','declined'] && n.route == 'post/' + r.postId);
    }
    function eventBooking(n, recipient) {
      let b = get(/databases/$(database)/documents/bookings/$(n.sourceId)).data;
      return n.params.user == get(userPath()).data.username
        && (b.ownerId == uid() && b.sitterId == recipient || b.sitterId == uid() && b.ownerId == recipient)
        && (n.type == 'booking_request' ? b.ownerId == uid() && b.status == 'requested' && n.route == 'bookings?tab=sitter'
          : n.params.status == b.status && n.route in ['bookings','bookings?tab=sitter']);
    }
    function eventMatch(n, recipient) {
      let m = get(/databases/$(database)/documents/matches/$(n.sourceId)).data;
      let lost = postAt(m.lostPostId);
      let sighting = postAt(m.sightingPostId);
      return uid() in m.members && recipient in m.members && n.params.name == lost.name
        && (n.type == 'match_found' ? recipient == m.lostOwnerId && n.route == 'match/' + n.sourceId
          : n.type == 'match_reporter' ? recipient == m.sightingOwnerId && n.route == 'match/' + n.sourceId
          : n.type == 'match_reunited' ? uid() == m.lostOwnerId && m.ownerState == 'reunited' && recipient == m.sightingOwnerId
          : uid() == m.lostOwnerId && m.ownerState == 'need_info' && recipient == m.sightingOwnerId)
        && lost.hidden == false && sighting.hidden == false;
    }
    function eventPostUpdate(n, recipient) {
      let p = n.route[5:];
      let u = get(/databases/$(database)/documents/posts/$(p)/updates/$(n.sourceId)).data;
      return n.route.matches('post/.+') && u.byUid == uid() && postAt(p).ownerId == recipient
        && n.params.user == get(userPath()).data.username && n.params.name == postAt(p).name && n.params.kind == u.kind;
    }
    function eventFollowed(n, recipient) {
      let c = get(/databases/$(database)/documents/cats/$(n.route[4:])).data;
      return n.route.matches('cat/.+') && recipient in c.followers && n.params.cat == c.name
        && n.params.user == get(userPath()).data.username
        && (n.params.area == 'medical' ? isVolunteer()
          && get(/databases/$(database)/documents/medicalRecords/$(n.sourceId)).data.byUid == uid()
          && get(/databases/$(database)/documents/medicalRecords/$(n.sourceId)).data.catId == n.route[4:] :
          get(/databases/$(database)/documents/sightings/$(n.sourceId)).data.userId == uid()
          && get(/databases/$(database)/documents/sightings/$(n.sourceId)).data.catId == n.route[4:]
          && get(/databases/$(database)/documents/sightings/$(n.sourceId)).data.neighborhood == n.params.area);
    }
    function notificationEvent(n, recipient) {
      return n.type == 'message' && eventMessage(n, recipient)
        || n.type in ['adoption_request','adoption_decision'] && eventAdoption(n, recipient)
        || n.type in ['booking_request','booking_update'] && eventBooking(n, recipient)
        || n.type in ['match_found','match_reporter','match_info','match_reunited'] && eventMatch(n, recipient)
        || n.type == 'post_update' && eventPostUpdate(n, recipient)
        || n.type == 'followed_cat' && eventFollowed(n, recipient)
        || n.type == 'review' && get(/databases/$(database)/documents/reviews/$(n.sourceId)).data.authorId == uid()
          && get(/databases/$(database)/documents/reviews/$(n.sourceId)).data.sitterId == recipient
          && n.route == 'sitter/' + recipient && n.params.user == get(userPath()).data.username
          && n.params.rating == ['', '1','2','3','4','5'][get(/databases/$(database)/documents/reviews/$(n.sourceId)).data.rating]
        || n.type == 'rescue_moderation' && get(/databases/$(database)/documents/rescues/$(n.sourceId)).data.reporterId == uid()
          && n.route == 'rescue/' + n.sourceId
          && n.params.type == get(/databases/$(database)/documents/rescues/$(n.sourceId)).data.type
          && n.params.area == get(/databases/$(database)/documents/rescues/$(n.sourceId)).data.neighborhood
          && get(/databases/$(database)/documents/users/$(recipient)).data.role in ['moderator','admin']
        || n.type == 'rescue_update' && isVolunteer()
          && get(/databases/$(database)/documents/rescues/$(n.sourceId)).data.reporterId == recipient
          && n.route == 'rescue/' + n.sourceId
          && n.params.area == get(/databases/$(database)/documents/rescues/$(n.sourceId)).data.neighborhood
          && get(/databases/$(database)/documents/rescues/$(n.sourceId)).data.status == n.params.status
        || n.type in ['moderation','rescue_volunteer','volunteer_decision','maintenance_update'] && isMod();
    }

    // Username -> uid, so names stay unique. Readable before sign-in for the registration check.
    // The app may only write `uid`; `loginEmail` (username sign-in for demo accounts) is set by admin tooling.
    match /usernames/{name} {
      allow get: if true;
      allow list: if false;
      allow create: if signedIn() && incoming().uid == uid() && incoming().keys().hasOnly(['uid'])
        && name.matches('[a-z0-9_.]{3,20}')
        && getAfter(userPath()).data.username.lower() == name;
      allow delete: if isAdmin() || (signedIn() && resource.data.uid == uid()
        && (!existsAfter(userPath()) || getAfter(userPath()).data.username.lower() != name));
      allow update: if false;
    }

    // Every aggregate step names the source created/deleted in this same atomic write. `ch` is changed().
    // One more: the source is created in this write by this person. Each source (sighting, check-in, post update) has
    // a single create rule that already requires a verified, rate-limited writer and names this counter, so those
    // checks aren't repeated here: the budget of 1,000 expressions is shared by every document in the batch.
    function sourceStep(collectionPath, parentField, parentId, ownerField, countField, ch) {
      let source = path('/databases/' + database + '/documents/' + collectionPath + '/' + incoming().counterSourceId);
      let before = resource.data.get(countField, 0);
      let after = incoming()[countField];
      return (!('updatedAt' in ch) || notFuture(incoming().updatedAt))
        && incoming().counterSourceId is string && incoming().counterSourceId.matches('[A-Za-z0-9_.-]{1,128}') && (
        (after == before + 1 && !exists(source)
          && getAfter(source).data[parentField] == parentId && getAfter(source).data[ownerField] == uid())
        || (signedIn() && before >= 0 && after == (before > 0 ? before - 1 : 0)
          && exists(source) && !existsAfter(source) && get(source).data[parentField] == parentId
          && (get(source).data[ownerField] == uid() || resource.data.get('ownerId', '') == uid())));
    }

    // ---------- cats ----------
    function communityCatFields() {
      return ['counterSourceId', 'sightingCount', 'lastSeen', 'lat', 'lng', 'neighborhood', 'neighborhoods', 'photoIds',
              'coverPhotoId', 'contributors', 'followers', 'aliases', 'tnrStatus', 'healthStatus',
              'features', 'geoCells', 'searchTerms', 'updatedAt'];
    }
    // Only volunteers may mark a cat as verified neutered (the role lookup comes last: it is the costly part).
    function tnrAllowed() {
      return (resource.data.tnrVerified == true
            ? incoming().tnrStatus == resource.data.tnrStatus
            : incoming().tnrStatus != 'neutered_verified')
        || isVolunteer();
    }

    function catTextOk(d) {
      return d.keys().hasOnly(['name', 'aliases', 'description', 'distinctiveMarks', 'coatColor', 'pattern', 'size', 'sex', 'breedHints', 'photoIds', 'coverPhotoId', 'createdBy', 'createdByName', 'contributors', 'followers', 'firstSeen', 'lastSeen', 'sightingCount', 'counterSourceId', 'lat', 'lng', 'neighborhood', 'neighborhoods', 'tnrStatus', 'tnrVerified', 'healthStatus', 'features', 'mergedInto', 'hidden', 'createdAt', 'updatedAt', 'geoCells', 'searchTerms', 'removedPhotoIds'])
        && optStr(d, 'name', 60) && optStr(d, 'description', 2000) && optStr(d, 'distinctiveMarks', 1000)
        && optStr(d, 'createdByName', 40) && optStr(d, 'coverPhotoId', 128) && optStr(d, 'neighborhood', 80)
        // features: CatAnalyzer.FEATURE_SIZE is 117.
        && communityPhotos(d.get('photoIds', [])) && communityPhoto(d.get('coverPhotoId', ''))
        && optList(d, 'photoIds', 1000) && optList(d, 'aliases', 50) && optList(d, 'breedHints', 20) && optList(d, 'features', 200)
        && optList(d, 'neighborhoods', 200) && geoCellsOk(d) && searchTermsOk(d);
    }
    // Someone else's cat: followers and contributors change only by the writer themself, photos and aliases are only
    // added, and the cat's place, photos and health change only together with a new sighting (which counts one more
    // sighting and stamps the writer's rate limit in the same batch, see CatRepository.addSighting).
    function addedOnly(ch, k, maxNew) {
      return !(k in ch) || (incoming()[k] is list
        && incoming()[k].toSet().hasAll(resource.data.get(k, []).toSet())
        && incoming()[k].size() <= resource.data.get(k, []).size() + maxNew);
    }
    function onlySelfAddedOrRemoved(ch, k) {
      return !(k in ch) || (incoming()[k] is list
        && incoming()[k].toSet().difference(resource.data.get(k, []).toSet()).hasOnly([uid()])
        && resource.data.get(k, []).toSet().difference(incoming()[k].toSet()).hasOnly([uid()]));
    }
    // The new sighting itself is checked by sourceStep (created in this write, by this person); its own create rule
    // stamps the rate limit.
    function newSightingOfCatOk(ch, before, d) {
      return d.sightingCount == before.get('sightingCount', 0) + 1
        && addedOnly(ch, 'photoIds', 6) && addedOnly(ch, 'neighborhoods', 1)
        && (!('contributors' in ch) || (addedOnly(ch, 'contributors', 1)
            && d.contributors.toSet().difference(before.get('contributors', []).toSet()).hasOnly([uid()])))
        && (!('coverPhotoId' in ch) || (before.get('coverPhotoId', '') == '' && d.coverPhotoId in d.photoIds))
        && (!ch.hasAny(['lat', 'lng', 'neighborhood', 'lastSeen'])
            || (notFuture(d.lastSeen) && d.lastSeen >= before.get('lastSeen', 0)));
    }
    // Only the fields a community update may change are checked again: the rest of the profile is unchanged and was
    // checked when it was written (catTextOk on the whole profile doesn't fit the budget of a sighting batch).
    function communityCatFieldsOk(ch, d) {
      return (!('photoIds' in ch) || (d.photoIds.size() <= 1000 && communityPhotos(d.photoIds)))
        && (!('coverPhotoId' in ch) || (d.coverPhotoId.size() <= 128 && communityPhoto(d.coverPhotoId)))
        && (!('neighborhood' in ch) || (d.neighborhood is string && d.neighborhood.size() <= 80))
        && (!('neighborhoods' in ch) || d.neighborhoods.size() <= 200)
        && (!('aliases' in ch) || d.aliases.size() <= 50)
        && (!('features' in ch) || (d.features is list && d.features.size() <= 200))
        && (!('geoCells' in ch) || geoCellsOk(d)) && (!('searchTerms' in ch) || searchTermsOk(d));
    }
    function communityCatUpdateOk(ch) {
      let before = resource.data;
      let d = incoming();
      return ch.hasOnly(communityCatFields()) && communityCatFieldsOk(ch, d) && tnrAllowed()
        && onlySelfAddedOrRemoved(ch, 'followers')
        && addedOnly(ch, 'aliases', 1)
        && (
          // Following / unfollowing, or adding a name the cat is also known by.
          !ch.hasAny(['sightingCount', 'lastSeen', 'lat', 'lng', 'neighborhood', 'neighborhoods', 'photoIds', 'coverPhotoId',
                      'contributors', 'tnrStatus', 'healthStatus', 'features', 'geoCells'])
          // A new sighting of this cat.
          || newSightingOfCatOk(ch, before, d)
          // A sighting of this cat was deleted.
          || (ch.hasOnly(['sightingCount', 'updatedAt', 'counterSourceId']) && before.get('sightingCount', 0) > 0
              && d.sightingCount == before.get('sightingCount', 0) - 1));
    }

    function ownedImage(id) { return get(/databases/$(database)/documents/images/$(id)).data.ownerId == uid(); }
    function selfDetachCat(ch) {
      let d = incoming();
      let removed = d.get('removedPhotoIds', []);
      return signedIn() && ch.hasOnly(['photoIds','coverPhotoId','removedPhotoIds','contributors','followers'])
        && onlySelfAddedOrRemoved(ch, 'contributors') && onlySelfAddedOrRemoved(ch, 'followers')
        && d.get('contributors', []).toSet().difference(resource.data.get('contributors', []).toSet()).size() == 0
        && d.get('followers', []).toSet().difference(resource.data.get('followers', []).toSet()).size() == 0
        && removed is list && removed.size() <= 3
        && (!ch.hasAny(['photoIds','coverPhotoId','removedPhotoIds']) || (
          d.photoIds.toSet() == resource.data.get('photoIds', []).toSet().difference(removed.toSet())
          && resource.data.get('photoIds', []).toSet().hasAll(removed.toSet())
          && (removed.size() < 1 || ownedImage(removed[0])) && (removed.size() < 2 || ownedImage(removed[1]))
          && (removed.size() < 3 || ownedImage(removed[2]))
          && ((d.coverPhotoId == resource.data.coverPhotoId && !(resource.data.coverPhotoId in removed))
            || (resource.data.coverPhotoId in removed && d.coverPhotoId == (d.photoIds.size() > 0 ? d.photoIds[0] : '')))));
    }
    match /cats/{catId} {
      allow read: if member();
      allow create: if verified()
        && incoming().createdBy == uid()
        && incoming().hidden == false
        && incoming().mergedInto == ''
        && incoming().tnrVerified == false
        && incoming().tnrStatus != 'neutered_verified'
        && incoming().get('followers', []) == [uid()]
        && incoming().get('contributors', []) == [uid()]
        && incoming().get('sightingCount', 1) == 1
        && rateLimited() && !exists(/databases/$(database)/documents/sightings/$(incoming().counterSourceId))
        && getAfter(/databases/$(database)/documents/sightings/$(incoming().counterSourceId)).data.catId == catId
        && getAfter(/databases/$(database)/documents/sightings/$(incoming().counterSourceId)).data.userId == uid()
        && notFuture(incoming().get('createdAt', 0))
        && catTextOk(incoming());
      allow update: if catUpdateOk(catId, changed());
      allow delete: if isMod();
    }
    // The cat's diff is worked out once (`ch`), and each branch starts with its cheapest test.
    function catUpdateOk(catId, ch) {
      return (resource.data.createdBy == uid() && verified()
            && !ch.hasAny(['createdBy', 'createdByName', 'createdAt', 'hidden', 'mergedInto', 'tnrVerified','sightingCount','counterSourceId'])
            && tnrAllowed() && catTextOk(incoming()))
        || (verified() && communityCatUpdateOk(ch)
          && (!ch.hasAny(['sightingCount','counterSourceId']) || sourceStep('sightings', 'catId', catId, 'userId', 'sightingCount', ch)))
        || (ch.hasOnly(['sightingCount','counterSourceId','updatedAt']) && signedIn()
          && sourceStep('sightings','catId',catId,'userId','sightingCount', ch))
        // Volunteers confirm neutering (TNR) on top of what any member may do.
        || (ch.hasOnly(['tnrStatus', 'tnrVerified', 'updatedAt']) && isVolunteer())
        || isMod() || selfDetachCat(ch)
        // The PC worker fills in the map-area codes and search words of profiles written by older app versions
        // (cat-server backfill).
        || (aiWorker() && ch.hasOnly(['geoCells', 'searchTerms']) && geoCellsOk(incoming()) && searchTermsOk(incoming()));
    }

    // ---------- sightings ----------
    function sightingTextOk(d) {
      return optStr(d, 'catName', 80) && optStr(d, 'username', 40) && optStr(d, 'notes', 2000) && optStr(d, 'aiSummary', 2000)
        && optStr(d, 'neighborhood', 80) && communityPhotos(d.get('photoIds', [])) && optList(d, 'photoIds', 6) && optList(d, 'healthTags', 20) && optList(d, 'behaviorTags', 20);
    }

    match /sightings/{sightingId} {
      allow read: if member();
      allow create: if verified()
        && incoming().keys().hasOnly(['catId', 'catName', 'userId', 'username', 'photoIds', 'seenAt', 'lat', 'lng', 'neighborhood',
             'locationSource', 'coatColor', 'pattern', 'size', 'healthTags', 'behaviorTags', 'earTipped', 'possiblyNotNeutered',
             'needsMedical', 'notes', 'newCat', 'matchScore', 'aiSummary', 'suggestedCatIds', 'rejectedCatIds', 'status',
             'createdAt', 'updatedAt'])
        && sightingTextOk(incoming())
        && notFuture(incoming().get('createdAt', 0)) && notFuture(incoming().get('seenAt', 0))
        && incoming().userId == uid()
        && incoming().status == 'pending'
        && getAfter(/databases/$(database)/documents/cats/$(incoming().catId)).data.counterSourceId == sightingId
        && getAfter(/databases/$(database)/documents/cats/$(incoming().catId)).data.sightingCount ==
          (exists(/databases/$(database)/documents/cats/$(incoming().catId)) ? get(/databases/$(database)/documents/cats/$(incoming().catId)).data.get('sightingCount', 0) + 1 : 1)
        && incoming().get('suggestedCatIds', []).size() <= 6
        && incoming().get('rejectedCatIds', []).size() <= 6
        && rateLimited();
      allow update: if isMod()
        || (verified() && resource.data.userId == uid() && sightingTextOk(incoming())
            && onlyChanging(['notes', 'healthTags', 'behaviorTags', 'earTipped', 'possiblyNotNeutered',
                             'needsMedical', 'lat', 'lng', 'neighborhood', 'locationSource', 'updatedAt']));
      allow delete: if signedIn() && (resource.data.userId == uid() || isMod());
    }

    // Exact coordinates of a sighting: author and volunteers only.
    // Phase 9 size caps (here and below): only the app's fields, and the free text joined with `+`, which bounds its
    // total size in one step and fails for anything that isn't text. The limits are well above what the apps allow.
    function exactLocationOk(d) {
      return d.keys().hasOnly(['ownerId', 'lat', 'lng', 'accuracy']) && (d.lat + d.lng + d.get('accuracy', 0)) is number;
    }
    match /privateLocations/{sightingId} {
      allow read: if signedIn() && (resource.data.ownerId == uid() || isVolunteer());
      // A location belongs to its sighting, and ownership cannot be reassigned.
      allow create: if verified() && incoming().ownerId == uid()
        && getAfter(/databases/$(database)/documents/sightings/$(sightingId)).data.userId == uid()
        && exactLocationOk(incoming());
      allow update: if verified() && resource.data.ownerId == uid()
        && incoming().ownerId == resource.data.ownerId && exactLocationOk(incoming());
      allow delete: if signedIn() && (resource == null || resource.data.ownerId == uid() || isMod());
    }

    // Verified medical information, written by volunteers and staff.
    match /medicalRecords/{recordId} {
      allow read: if member();
      allow create: if isVolunteer() && incoming().byUid == uid()
        && incoming().keys().hasOnly(['catId', 'type', 'note', 'byUid', 'byName', 'at'])
        && ('' + incoming().get('catId', '') + incoming().get('type', '') + incoming().get('note', '') + incoming().get('byName', '')).size() <= 2500;
      allow update: if isMod();
      allow delete: if isAdmin();
    }

    // ---------- rescue reports ----------
    function volunteerVisible() { return ['approved', 'in_progress', 'resolved']; }
    // The history only grows: everything already there stays as it was, and the one new entry is the writer's own.
    function appendedOwnRescueNote() {
      let before = resource.data.get('updates', []);
      let after = incoming().get('updates', []);
      return after is list && after.size() == before.size() + 1
        && after[0:before.size()] == before
        && after[before.size()].byUid == uid()
        && after[before.size()].get('note', '') is string && after[before.size()].get('note', '').size() <= 1000;
    }

    function rescueFieldsOk(d) {
      return d.keys().hasOnly(['type', 'urgency', 'description', 'landmark', 'photoIds', 'lat', 'lng', 'neighborhood', 'catId',
                               'catName', 'reporterId', 'reporterName', 'status', 'assignedTo', 'assignedName', 'updates',
                               'createdAt', 'updatedAt'])
        && ('' + d.get('type', '') + d.get('urgency', '') + d.get('description', '') + d.get('landmark', '') + d.get('neighborhood', '') + d.get('catId', '') + d.get('catName', '') + d.get('reporterName', '') + d.get('assignedTo', '') + d.get('assignedName', '')).size() <= 4000
        && communityPhotos(d.get('photoIds', [])) && optList(d, 'photoIds', 12) && optList(d, 'updates', 3) && notFuture(d.get('createdAt', 0));
    }
    match /rescues/{reportId} {
      allow read: if signedIn() && (
        isMod() || maintenanceWorker()
        || resource.data.reporterId == uid()
        || (isVolunteer() && resource.data.status in volunteerVisible()));
      allow create: if verified()
        && incoming().reporterId == uid()
        && incoming().status == 'submitted'
        && rescueFieldsOk(incoming())
        && rateLimited();
      allow update: if isMod()
        || (isVolunteer()
            && resource.data.status in volunteerVisible()
            && incoming().status in volunteerVisible()
            && onlyChanging(['status', 'updates', 'assignedTo', 'assignedName', 'updatedAt'])
            && (notChanging(['updates']) || appendedOwnRescueNote())
            // A volunteer takes a report on themself; they can't hand it to someone else.
            && (notChanging(['assignedTo']) || incoming().assignedTo == uid())
            && optStr(incoming(), 'assignedName', 40))
        || (verified() && resource.data.reporterId == uid() && onlyChanging(['updates', 'updatedAt']) && appendedOwnRescueNote());
      allow delete: if isAdmin() || (signedIn() && resource.data.reporterId == uid());
    }

    // ---------- Ehsan feeding stations ----------
    match /stations/{stationId} {
      allow read: if member();
      allow create, delete: if isAdmin();
      // A check-in counts exactly one more visit; deleting one (yours, or during account deletion) one fewer.
      allow update: if stationCheckinStep(stationId, changed()) || isAdmin();
    }
    function stationCheckinStep(stationId, ch) {
      return signedIn() && ch.hasOnly(['checkinCount', 'lastCheckinAt', 'lastCheckinBy', 'counterSourceId'])
        && sourceStep('checkins', 'stationId', stationId, 'userId', 'checkinCount', ch)
        && notFuture(incoming().get('lastCheckinAt', 0)) && optStr(incoming(), 'lastCheckinBy', 40);
    }

    match /checkins/{checkinId} {
      allow read: if member();
      allow create: if verified() && incoming().userId == uid()
        && incoming().keys().hasOnly(['stationId', 'stationName', 'userId', 'username', 'catsSeen', 'catIds', 'foodLevel', 'waterLevel', 'note', 'at'])
        && optStr(incoming(), 'note', 1000) && optStr(incoming(), 'stationName', 120) && optStr(incoming(), 'username', 40)
        && optList(incoming(), 'catIds', 30) && notFuture(incoming().get('at', 0))
        && incoming().username == get(userPath()).data.username
        && getAfter(/databases/$(database)/documents/stations/$(incoming().stationId)).data.counterSourceId == checkinId
        && rateLimited();
      allow delete: if signedIn() && (resource.data.userId == uid() || isAdmin());
    }

    match /maintenance/{reportId} {
      allow read: if member();
      allow create: if verified()
        && incoming().userId == uid()
        && incoming().status == 'open'
        && incoming().keys().hasOnly(['stationId', 'stationName', 'userId', 'username', 'issue', 'description', 'status',
                                      'resolutionNote', 'resolvedBy', 'createdAt', 'updatedAt'])
        && ('' + incoming().get('stationId', '') + incoming().get('stationName', '') + incoming().get('username', '') + incoming().get('issue', '') + incoming().get('description', '') + incoming().get('resolutionNote', '') + incoming().get('resolvedBy', '')).size() <= 3000
        && rateLimited();
      allow update: if isAdmin();
      allow delete: if isAdmin() || (signedIn() && resource.data.userId == uid());
    }

    // ---------- moderation ----------
    match /mergeRequests/{requestId} {
      allow read: if member();
      allow create: if verified() && incoming().requestedBy == uid() && incoming().status == 'pending'
        && incoming().keys().hasOnly(['primaryCatId', 'primaryName', 'duplicateCatId', 'duplicateName', 'requestedBy',
                                      'requestedByName', 'reason', 'similarity', 'status', 'reviewedBy', 'reviewedByName',
                                      'reviewNote', 'createdAt', 'reviewedAt'])
        && ('' + incoming().get('primaryCatId', '') + incoming().get('primaryName', '') + incoming().get('duplicateCatId', '') + incoming().get('duplicateName', '') + incoming().get('requestedByName', '') + incoming().get('reason', '') + incoming().get('reviewNote', '')).size() <= 3000;
      allow update: if isMod();
      allow delete: if signedIn() && resource.data.requestedBy == uid();
    }

    match /contentReports/{reportId} {
      allow read: if isMod() || (signedIn() && resource.data.reporterId == uid());
      allow create: if verified()
        && incoming().reporterId == uid()
        && incoming().status == 'open'
        && incoming().keys().hasOnly(['targetType', 'targetId', 'targetLabel', 'reason', 'details', 'reporterId',
                                      'reporterName', 'status', 'resolution', 'resolvedBy', 'createdAt'])
        && ('' + incoming().get('targetType', '') + incoming().get('targetId', '') + incoming().get('targetLabel', '') + incoming().get('reason', '') + incoming().get('details', '') + incoming().get('reporterName', '') + incoming().get('resolution', '')).size() <= 3000
        && rateLimited();
      allow update: if isMod();
      allow delete: if signedIn() && resource.data.reporterId == uid();
    }

    match /modActions/{actionId} {
      allow read: if isMod();
      allow create: if isMod() && incoming().moderatorId == uid();
    }

    match /volunteerApplications/{applicantId} {
      allow read: if signedIn() && (uid() == applicantId || isAdmin());
      allow create, update: if (signedIn() && uid() == applicantId
                                && incoming().userId == uid()
                                && incoming().status == 'pending'
                                && incoming().keys().hasOnly(['userId', 'username', 'motivation', 'experience', 'area',
                                                              'status', 'reviewedBy', 'createdAt'])
                                && ('' + incoming().get('username', '') + incoming().get('motivation', '') + incoming().get('experience', '') + incoming().get('area', '') + incoming().get('reviewedBy', '')).size() <= 4000)
                            || isAdmin();
      allow delete: if signedIn() && (uid() == applicantId || isAdmin());
    }

    // ---------- animal posts: lost, found, spotted, needs help, street, adoption, other ----------
    // 27 numbers or none. Adding them up fails for anything that isn't a number, which is what keeps every phone able
    // to read the feed. The range of each number ([0, 1]) is checked by every reader instead (PostAppearance.valid on
    // Android and the web, fingerprint.valid on the PC): an out-of-range fingerprint only turns off colour matching
    // for its own post. Checking each number here took about a fifth of the rules budget of a post batch.
    function validFingerprint(f) {
      return f is list && (f.size() == 0 || (f.size() == 27 && fingerprintSumOk(f[0] + f[1] + f[2] + f[3] + f[4] + f[5] + f[6] + f[7] + f[8]
        + f[9] + f[10] + f[11] + f[12] + f[13] + f[14] + f[15] + f[16] + f[17] + f[18] + f[19] + f[20] + f[21] + f[22] + f[23] + f[24]
        + f[25] + f[26])));
    }
    function fingerprintSumOk(sum) { return sum is number && sum >= 0 && sum <= 27; }

    // Types and size limits. Types matter: the app converts a whole feed at once, so one post with, say, a number
    // where text belongs would break every phone's map. To stay inside the rules' budget of 1,000 expressions per
    // document (a 27-number fingerprint already uses much of it), the text fields are joined with `+`, which fails
    // unless every one of them is a string and bounds their total size in one step (the app's own limits add up to
    // about 3,300 characters, PostRepository.toPost). Lists are bounded through join().
    function postFieldsOk(d) {
      return ('' + d.ownerName + d.ownerPhotoId + d.name + d.description + d.color + d.breed + d.features + d.sex + d.ageGroup
              + d.videoPath + d.neighborhood + d.contactMethod + d.contactPhone + d.contactEmail + d.health).size() <= 4500
        && d.ownerName.size() <= 40 && d.features.size() <= 600 && d.health.size() <= 600
        && d.photoIds is list && photoListOk(d.photoIds.join(',')) && communityPhoto(d.get('ownerPhotoId', ''))
        && d.keywords is list && d.keywords.size() <= 100 && d.keywords.join(' ').size() <= 4000
        && (d.lat + d.lng) is number && d.lastSeenAt is int && d.updatesCount is int
        && [d.approximate, d.vaccinated, d.neutered, d.hidden].hasOnly([true, false]);
    }
    // Photo ids joined once: at most 800 characters, and no private chat photo (`c_...`).
    function photoListOk(joined) { return joined.size() <= 800 && !joined.matches('(^|.*,)(c_[^,]*)(,.*|$)'); }
    function postKeys() {
      return ['repairSourceId', 'counterSourceId', 'ownerId', 'ownerName', 'ownerPhotoId', 'animalType', 'category', 'status', 'name', 'description', 'color', 'breed', 'features', 'sex', 'ageGroup', 'photoIds', 'videoPath', 'lat', 'lng', 'approximate', 'areaRadiusM', 'neighborhood', 'lastSeenAt', 'reward', 'contactMethod', 'contactPhone', 'contactEmail', 'adoptionStatus', 'health', 'vaccinated', 'neutered', 'updatesCount', 'hidden', 'keywords', 'createdAt', 'updatedAt', 'resolvedAt', 'lastActivityAt', 'fingerprint', 'microchip', 'resolution', 'resolvedMatchId', 'geoCells', 'searchTerms'];
    }
    // BUDGET: the rules may evaluate at most 1,000 expressions per request, and a batch (a new post plus the author's
    // stats) shares them. Measure with tools/rulestest/budget.mjs after any change to a busy rule (26 Oct 2026, spare
    // in the tool's units: largest new post 72, its edits 64-84, sightings on someone else's cat 92-112, check-in 264).
    // A new post: everything is checked, under the author's real username (never a made-up name), open, unresolved
    // and with its counters at zero.
    function newPostOk(postId, d) {
      let latest = request.time.toMillis() + 3600000;
      return verified()
        && d.ownerId == request.auth.uid && !deletingPost(postId)
        && d.status == 'open' && d.get('resolution', '') == '' && d.get('resolvedMatchId', '') == ''
        && d.ownerName == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.username
        && d.hidden == false && d.updatesCount == 0 && d.get('counterSourceId', '') == ''
        && d.category in ['lost', 'found', 'spotted', 'needs_help', 'street', 'adoption', 'other']
        && d.animalType in ['cat', 'dog', 'bird', 'rabbit', 'other']
        && d.adoptionStatus in ['available', 'pending', 'adopted']
        && d.description.size() <= 2000 && d.name.size() <= 60
        && d.photoIds.size() <= 6
        && d.reward is int && d.reward >= 0 && d.reward < 1000000
        && d.areaRadiusM is int && d.areaRadiusM >= 0 && d.areaRadiusM <= 5000
        && d.get('lastActivityAt', 0) is int && d.get('lastActivityAt', 0) >= 0 && d.get('lastActivityAt', 0) <= latest
        && d.get('microchip', 'unknown') in ['yes','no','unknown']
        && validFingerprint(d.get('fingerprint', []))
        && geoCellsOk(d) && searchTermsOk(d) && postFieldsOk(d)
        // No post can claim to be newer than now (that would pin it to the top of every feed).
        && d.createdAt is int && d.createdAt <= latest && d.updatedAt is int && d.updatedAt <= latest
        && d.keys().hasOnly(postKeys())
        && rateLimited();
    }
    // An edit: only what changed is checked again. `ch` is what the update changes, worked out once by the caller.
    function validPostWith(ch) {
      let d = incoming();
      let latest = request.time.toMillis() + 3600000;
      return d.category in ['lost', 'found', 'spotted', 'needs_help', 'street', 'adoption', 'other']
        && d.animalType in ['cat', 'dog', 'bird', 'rabbit', 'other']
        && d.status in ['open', 'reunited', 'resolved']
        && d.adoptionStatus in ['available', 'pending', 'adopted']
        && d.description.size() <= 2000 && d.name.size() <= 60
        && d.photoIds.size() <= 6
        && d.reward is int && d.reward >= 0 && d.reward < 1000000
        && d.areaRadiusM is int && d.areaRadiusM >= 0 && d.areaRadiusM <= 5000
        && d.get('lastActivityAt', 0) is int && d.get('lastActivityAt', 0) >= 0
        && d.get('microchip', 'unknown') in ['yes','no','unknown']
        && (!('fingerprint' in ch) || validFingerprint(d.get('fingerprint', [])))
        // How a lost/found report was closed: through a CatMap match, the animal came home by itself, or other.
        && d.get('resolution', '') in ['', 'catmap', 'home', 'other']
        && d.get('resolvedMatchId', '') is string && d.get('resolvedMatchId', '').size() <= 300
        && (!('geoCells' in ch) || geoCellsOk(d))
        && (!('searchTerms' in ch) || searchTermsOk(d))
        && (!ch.hasAny(['ownerId', 'ownerName', 'ownerPhotoId', 'name', 'description', 'color', 'breed', 'features', 'sex', 'ageGroup',
                        'videoPath', 'neighborhood', 'contactMethod', 'contactPhone', 'contactEmail', 'health', 'photoIds', 'keywords',
                        'lat', 'lng', 'approximate', 'lastSeenAt', 'vaccinated', 'neutered', 'hidden', 'updatesCount'])
            || postFieldsOk(d))
        // No post can claim to be newer than now (that would pin it to the top of every feed).
        && (!ch.hasAny(['createdAt', 'lastActivityAt', 'updatedAt'])
            || (d.createdAt is int && d.createdAt <= latest && d.get('lastActivityAt', 0) <= latest
                && d.updatedAt is int && d.updatedAt <= latest))
        && d.keys().hasOnly(postKeys());
    }

    // `ch` is changed(), worked out once by the caller: diffing a 40-field post twice doesn't fit the budget.
    function ownerPostUpdateOk(postId, ch) {
      return !ch.hasAny(['ownerId', 'ownerName', 'hidden', 'createdAt', 'updatesCount', 'counterSourceId','repairSourceId'])
        && validPostWith(ch) && reunionSourceOk(postId, ch);
    }
    function reunionSourceOk(postId, ch) {
      let d = incoming();
      return !ch.hasAny(['status','resolution','resolvedMatchId']) || d.get('resolvedMatchId', '') == ''
        || (d.status == 'reunited' && d.get('resolution', '') == 'catmap'
          && getAfter(/databases/$(database)/documents/matches/$(d.resolvedMatchId)).data.lostPostId == postId
          && getAfter(/databases/$(database)/documents/matches/$(d.resolvedMatchId)).data.lostOwnerId == uid()
          && getAfter(/databases/$(database)/documents/matches/$(d.resolvedMatchId)).data.ownerState == 'reunited');
    }

    // The post's diff is worked out once (`ch`: a 40-field diff is costly), and the owner's edit, by far the most
    // common update, is tried first.
    function postUpdateOk(postId, ch) {
      return (resource.data.ownerId == uid() && verified() && ownerPostUpdateOk(postId, ch))
        || (ch.hasOnly(['updatesCount', 'updatedAt', 'counterSourceId']) && signedIn()
            && sourceStep('posts/' + postId + '/updates', 'postId', postId, 'byUid', 'updatesCount', ch))
        || (resource.data.ownerId == uid() && ch.hasOnly(['hidden']) && incoming().hidden == true
          && existsAfter(/databases/$(database)/documents/postDeletions/$(postId)))
        || (maintenanceWorker() && ch.hasOnly(['updatesCount','repairSourceId'])
          && incoming().updatesCount is int && incoming().updatesCount >= 0
          && get(/databases/$(database)/documents/updateRepairs/$(incoming().repairSourceId)).data.postId == postId
          && !existsAfter(/databases/$(database)/documents/updateRepairs/$(incoming().repairSourceId)))
        || (isMod() && validPostWith(ch))
        // The PC worker fills in the map-area codes and search words of posts written by older app versions
        // (recovery.py, backfill).
        || (aiWorker() && ch.hasOnly(['geoCells', 'searchTerms']) && geoCellsOk(incoming()) && searchTermsOk(incoming()));
    }

    function deletingPost(id) { return exists(/databases/$(database)/documents/postDeletions/$(id)); }
    function maintenanceWorker() { return aiWorker() && request.auth.token.get('catmapMaintenance', false) == true; }
    match /mediaUploads/{id} {
      allow get: if signedIn() && (resource == null || resource.data.ownerId == uid() || maintenanceWorker());
      allow list: if maintenanceWorker() || (signedIn() && resource.data.ownerId == uid());
      allow create: if verified() && incoming().keys().hasOnly(['ownerId','chatId','audience','status','expiresAt'])
        && incoming().ownerId == uid() && incoming().status == 'staged'
        && incoming().audience in ['community','chat'] && optStr(incoming(), 'chatId', 300)
        && incoming().expiresAt is int && incoming().expiresAt > request.time.toMillis()
        && incoming().expiresAt <= request.time.toMillis() + 691200000
        && getAfter(/databases/$(database)/documents/images/$(id)).data.ownerId == uid()
        && getAfter(/databases/$(database)/documents/images/$(id)).data.audience == incoming().audience
        && getAfter(/databases/$(database)/documents/images/$(id)).data.chatId == incoming().chatId;
      allow update: if (signedIn() && resource.data.ownerId == uid() && resource.data.status in ['staged','linked']
          && onlyChanging(['expiresAt']) && incoming().expiresAt is int && incoming().expiresAt > request.time.toMillis()
          && incoming().expiresAt <= request.time.toMillis() + 691200000)
        || (maintenanceWorker() && onlyChanging(['status','expiresAt']) && incoming().status in ['linked','deleting','deleted']);
      allow delete: if signedIn() && (resource == null || resource.data.ownerId == uid() || maintenanceWorker());
    }
    match /videoUploads/{id} {
      allow get: if signedIn() && (resource == null || resource.data.ownerId == uid() || maintenanceWorker());
      allow list: if maintenanceWorker() || (signedIn() && resource.data.ownerId == uid());
      allow create: if verified() && incoming().keys().hasOnly(['ownerId','path','status','expiresAt'])
        && incoming().ownerId == uid() && incoming().path == 'videos/' + uid() + '/' + id && incoming().status == 'staged'
        && incoming().expiresAt is int && incoming().expiresAt > request.time.toMillis() && incoming().expiresAt <= request.time.toMillis() + 691200000;
      allow update: if (signedIn() && resource.data.ownerId == uid() && resource.data.status in ['staged','linked']
          && onlyChanging(['expiresAt']) && incoming().expiresAt is int && incoming().expiresAt > request.time.toMillis()
          && incoming().expiresAt <= request.time.toMillis() + 691200000)
        || (maintenanceWorker() && onlyChanging(['status','expiresAt']) && incoming().status in ['linked','deleting','deleted']);
      allow delete: if signedIn() && (resource == null || resource.data.ownerId == uid() || maintenanceWorker());
    }
    match /accountDeletions/{id} {
      allow get: if (signedIn() && uid() == id) || maintenanceWorker();
      allow create, update: if signedIn() && uid() == id && incoming().keys().hasOnly(['requestedAt']) && incoming().requestedAt == request.time;
      // Retaining this UID-only tombstone prevents recreating a deleted suspended profile.
      allow delete: if isAdmin();
    }
    match /updateRepairs/{id} {
      allow create: if signedIn() && incoming().keys().hasOnly(['postId','updateId','byUid']) && incoming().byUid == uid()
        && incoming().postId is string && incoming().updateId is string
        && id == string(incoming().postId.toUtf8().size()) + '_' + incoming().postId + '_' + incoming().updateId
        && get(/databases/$(database)/documents/posts/$(incoming().postId)/updates/$(incoming().updateId)).data.byUid == uid()
        && !existsAfter(/databases/$(database)/documents/posts/$(incoming().postId)/updates/$(incoming().updateId));
      allow read, delete: if maintenanceWorker();
    }
    match /postDeletions/{id} {
      allow read: if signedIn() && (resource == null || resource.data.ownerId == uid() || resource.data.actorId == uid() || isMod() || maintenanceWorker());
      allow create: if signedIn() && (postAt(id).ownerId == uid() || isMod())
        && incoming().keys().hasOnly(['ownerId','actorId','photoIds','videoPath','createdAt','status'])
        && incoming().ownerId == postAt(id).ownerId && incoming().actorId == uid()
        && incoming().photoIds == postAt(id).get('photoIds', []) && incoming().videoPath == postAt(id).get('videoPath', '')
        && incoming().status == 'pending' && notFuture(incoming().createdAt)
        && postAfter(id).hidden == true;
      allow update: if maintenanceWorker() && onlyChanging(['status']) && incoming().status == 'done';
    }
    match /lostAlertJobs/{id} {
      allow read: if maintenanceWorker() || (signedIn() && resource.data.ownerId == uid());
      allow create: if verified() && incoming().keys().hasOnly(['ownerId','status','cursor','createdAt'])
        && incoming().ownerId == uid() && incoming().status == 'pending' && incoming().cursor == ''
        && notFuture(incoming().createdAt) && postAfter(id).ownerId == uid() && postAfter(id).category == 'lost';
      allow update: if maintenanceWorker() && onlyChanging(['status','cursor'])
        && incoming().status in ['pending','done'] && optStr(incoming(), 'cursor', 128);
    }
    match /posts/{postId} {
      // Hidden posts stay visible to their author and to moderators only.
      allow get: if member() && (resource == null || resource.data.hidden == false || resource.data.ownerId == uid() || isMod() || maintenanceWorker());
      allow list: if member() && (resource.data.hidden == false || resource.data.ownerId == uid() || isMod() || maintenanceWorker());
      allow create: if newPostOk(postId, request.resource.data);
      allow update: if postUpdateOk(postId, changed());
      allow delete: if signedIn() && (resource.data.ownerId == uid() || isMod() || (maintenanceWorker() && deletingPost(postId)));

      match /updates/{updateId} {
        function parentVisible() {
          let p = get(/databases/$(database)/documents/posts/$(postId)).data;
          return p.hidden == false || p.ownerId == uid() || isMod();
        }
        allow read: if maintenanceWorker() || (signedIn() && (resource.data.byUid == uid() || (member() && parentVisible())));
        allow create: if verified() && parentVisible() && !deletingPost(postId)
          && incoming().byUid == uid() && incoming().postId == postId
          && postAfter(postId).counterSourceId == updateId
          && postAfter(postId).updatesCount == postAt(postId).get('updatesCount', 0) + 1
          && incoming().keys().hasOnly(['postId','kind','text','photoId','lat','lng','neighborhood','byUid','byName','createdAt'])
          && incoming().kind in ['sighting','progress','found_it'] && incoming().byName == get(userPath()).data.username
          && incoming().text is string && incoming().text.size() <= 1000
          && optStr(incoming(), 'photoId', 128) && optStr(incoming(), 'neighborhood', 64)
          && communityPhoto(incoming().get('photoId', ''))
          && incoming().lat is number && incoming().lat >= -90 && incoming().lat <= 90
          && incoming().lng is number && incoming().lng >= -180 && incoming().lng <= 180
          && notFuture(incoming().createdAt) && rateLimited();
        allow delete: if (maintenanceWorker() && deletingPost(postId)) || (signedIn() && (resource.data.byUid == uid() || isMod()
          || get(/databases/$(database)/documents/posts/$(postId)).data.ownerId == uid()));
      }
    }

    // Followed areas for lost-pet alerts. Readable by members so a poster can find who to alert.
    // The app now keeps the alert area's centre in users/{uid}/private/areaFollow and writes only the neighbourhood
    // list here. Older clients must upgrade before these rules are enabled; migrate existing centres first.
    match /areaFollows/{followerId} {
      allow read: if verified() || maintenanceWorker();
      allow create, update: if signedIn() && uid() == followerId
        && verified() && exists(userPath())
        && incoming().keys().hasOnly(['neighborhoods', 'updatedAt'])
        && areaNamesOk(incoming().neighborhoods) && notFuture(incoming().updatedAt);
      // An admin can strip a centre an old app version left behind (the neighbourhoods, and so the alerts, stay).
      allow update: if isAdmin() && changed().hasOnly(['lat', 'lng', 'radiusKm'])
        && !incoming().keys().hasAny(['lat', 'lng', 'radiusKm']);
      allow delete: if signedIn() && uid() == followerId;
    }

    // Ownership-filtered collection-group query used by export and account cleanup.
    match /{path=**}/updates/{updateId} {
      allow list: if maintenanceWorker() || (signedIn() && resource.data.byUid == uid());
    }

    // ---------- adoption requests: id = "{postId}_{requesterId}" ----------
    match /adoptionRequests/{requestId} {
      // A missing request can be looked up, so the app can show "not requested yet" without failing.
      allow get: if signedIn() && (resource == null || resource.data.requesterId == uid() || resource.data.ownerId == uid() || isMod());
      allow list: if maintenanceWorker() || (signedIn() && (resource.data.requesterId == uid() || resource.data.ownerId == uid() || isMod()));
      allow create: if verified()
        && incoming().requesterId == uid()
        && incoming().ownerId != uid()
        && incoming().status == 'pending'
        && requestId == incoming().postId + '_' + uid()
        && incoming().keys().hasOnly(['postId', 'postName', 'postPhotoId', 'ownerId', 'requesterId', 'requesterName',
                                      'message', 'home', 'status', 'ownerNote', 'createdAt', 'decidedAt'])
        && ('' + incoming().get('postName', '') + incoming().get('postPhotoId', '') + incoming().get('requesterName', '') + incoming().get('message', '') + incoming().get('home', '') + incoming().get('ownerNote', '')).size() <= 3000
        && postAt(incoming().postId).ownerId == incoming().ownerId
        && incoming().requesterName == get(userPath()).data.username && incoming().postName == postAt(incoming().postId).name
        && notFuture(incoming().createdAt) && communityPhoto(incoming().get('postPhotoId', ''))
        && postAt(incoming().postId).category == 'adoption' && postAt(incoming().postId).hidden == false
        && postAt(incoming().postId).status == 'open' && postAt(incoming().postId).adoptionStatus == 'available' && !deletingPost(incoming().postId);
      allow update: if
        (signedIn() && resource.data.ownerId == uid()
          && onlyChanging(['status', 'ownerNote', 'decidedAt']) && optStr(incoming(), 'ownerNote', 1000)
          && (incoming().status != 'approved' || (postAt(resource.data.postId).status == 'open'
            && postAt(resource.data.postId).category == 'adoption' && postAt(resource.data.postId).hidden == false
            && postAt(resource.data.postId).adoptionStatus == 'available' && postAfter(resource.data.postId).adoptionStatus == 'pending'
            && !deletingPost(resource.data.postId)))
          && resource.data.status == 'pending' && incoming().status in ['approved', 'declined'])
        || (signedIn() && resource.data.requesterId == uid()
          && onlyChanging(['status']) && resource.data.status == 'pending' && incoming().status == 'withdrawn')
        || isMod();
      allow delete: if (maintenanceWorker() && deletingPost(resource.data.postId)) || (signedIn() && (resource.data.requesterId == uid() || resource.data.ownerId == uid() || isMod()));
    }

    // ---------- pet sitting ----------
    function reviewAfter(id) { return getAfter(/databases/$(database)/documents/reviews/$(id)).data; }

    function sitterFieldsOk(d) {
      return d.keys().hasOnly(['uid', 'name', 'photoId', 'headline', 'description', 'experience', 'petTypes', 'services',
                               'availability', 'rate', 'rateUnit', 'lat', 'lng', 'neighborhood', 'active', 'ratingSum',
                               'verified', 'ratingCount', 'lastReviewId', 'createdAt', 'updatedAt'])
        && ('' + d.get('name', '') + d.get('photoId', '') + d.get('headline', '') + d.get('description', '') + d.get('experience', '') + d.get('availability', '') + d.get('rateUnit', '') + d.get('neighborhood', '')).size() <= 5000
        && communityPhoto(d.get('photoId', '')) && optList(d, 'petTypes', 12) && optList(d, 'services', 12);
    }
    match /sitters/{sitterId} {
      allow read: if member();
      allow create: if verified() && sitterId == uid()
        && incoming().ratingSum == 0 && incoming().ratingCount == 0
        && incoming().get('verified', false) == false
        && sitterFieldsOk(incoming());
      allow update: if incoming().get('verified', false) is bool && (notChanging(['verified']) || isAdmin()) && (
        (verified() && sitterId == uid() && notChanging(['ratingSum', 'ratingCount', 'lastReviewId']) && sitterFieldsOk(incoming()))
        // A reviewer adds exactly their new review's rating, in the same transaction that creates the review.
        || (verified() && onlyChanging(['ratingSum', 'ratingCount', 'lastReviewId', 'updatedAt'])
            && !exists(/databases/$(database)/documents/reviews/$(incoming().lastReviewId))
            && reviewAfter(incoming().lastReviewId).authorId == uid()
            && reviewAfter(incoming().lastReviewId).sitterId == sitterId
            && incoming().ratingCount == resource.data.ratingCount + 1
            && incoming().ratingSum == resource.data.ratingSum + reviewAfter(incoming().lastReviewId).rating)
        || isMod());
      allow delete: if signedIn() && (sitterId == uid() || isMod());
    }

    match /bookings/{bookingId} {
      allow read: if signedIn() && (resource.data.ownerId == uid() || resource.data.sitterId == uid() || isMod());
      allow create: if verified()
        && incoming().ownerId == uid()
        && incoming().sitterId != uid()
        && incoming().status == 'requested'
        && incoming().reviewed == false
        && incoming().keys().hasOnly(['ownerId', 'ownerName', 'sitterId', 'sitterName', 'petTypes', 'petCount', 'startAt',
                                      'endAt', 'notes', 'sitterNote', 'status', 'reviewed', 'createdAt', 'updatedAt'])
        && ('' + incoming().get('ownerName', '') + incoming().get('sitterName', '') + incoming().get('notes', '') + incoming().get('sitterNote', '')).size() <= 3000
        && optList(incoming(), 'petTypes', 12)
        && get(/databases/$(database)/documents/sitters/$(incoming().sitterId)).data.active == true
        && incoming().sitterName == get(/databases/$(database)/documents/sitters/$(incoming().sitterId)).data.name
        && incoming().ownerName == get(userPath()).data.username
        && incoming().petTypes.size() > 0 && incoming().petTypes.toSet().hasOnly(['cat','dog','bird','rabbit','other'])
        && incoming().startAt is int && incoming().endAt is int && incoming().startAt >= 0 && incoming().startAt < incoming().endAt
        && incoming().petCount is int && incoming().petCount >= 1 && incoming().petCount <= 20
        && notFuture(incoming().createdAt) && rateLimited();
      allow update: if
        (signedIn() && resource.data.ownerId == uid() && onlyChanging(['ownerName','notes']) && incoming().ownerName == '' && incoming().notes == '')
        || (signedIn() && resource.data.sitterId == uid() && onlyChanging(['sitterName','sitterNote']) && incoming().sitterName == '' && incoming().sitterNote == '')
        ||
        (signedIn() && resource.data.sitterId == uid()
          && onlyChanging(['status', 'sitterNote', 'updatedAt']) && optStr(incoming(), 'sitterNote', 1000)
          && ((resource.data.status == 'requested' && incoming().status in ['accepted', 'declined'])
              || (resource.data.status == 'accepted' && incoming().status in ['completed', 'cancelled'])))
        || (signedIn() && resource.data.ownerId == uid()
          && onlyChanging(['status', 'updatedAt'])
          && ((resource.data.status in ['requested', 'accepted'] && incoming().status == 'cancelled')
              || (resource.data.status == 'accepted' && incoming().status == 'completed')))
        // Marking a completed booking as reviewed must happen together with creating its review.
        || (signedIn() && resource.data.ownerId == uid()
          && onlyChanging(['reviewed', 'updatedAt'])
          && resource.data.status == 'completed' && resource.data.reviewed == false && incoming().reviewed == true
          && reviewAfter(bookingId).authorId == uid() && reviewAfter(bookingId).sitterId == resource.data.sitterId);
    }

    // One review per completed booking (the id is the booking id), written by the pet owner.
    match /reviews/{bookingId} {
      function booking() { return get(/databases/$(database)/documents/bookings/$(bookingId)).data; }
      allow read: if member();
      allow update: if signedIn() && resource.data.authorId == uid() && onlyChanging(['authorName','text']) && incoming().authorName == '' && incoming().text == '';
      allow create: if verified()
        && incoming().authorId == uid()
        && incoming().rating is int && incoming().rating >= 1 && incoming().rating <= 5
        && incoming().keys().hasOnly(['sitterId','authorId','authorName','rating','text','createdAt'])
        && incoming().authorName == get(userPath()).data.username && notFuture(incoming().createdAt)
        && incoming().text is string && incoming().text.size() <= 800
        && booking().reviewed == false
        && getAfter(/databases/$(database)/documents/bookings/$(bookingId)).data.reviewed == true
        && (!exists(/databases/$(database)/documents/sitters/$(incoming().sitterId))
          || getAfter(/databases/$(database)/documents/sitters/$(incoming().sitterId)).data.lastReviewId == bookingId)
        && booking().ownerId == uid()
        && booking().status == 'completed'
        && booking().sitterId == incoming().sitterId;
      allow delete: if isMod();
    }

    // ---------- private messages: chat id = the two uids, sorted, joined with "_" ----------
    match /chats/{chatId} {
      // A missing chat can be looked up (so the app can create it); existing chats only by their members.
      allow get: if signedIn() && (resource == null || uid() in resource.data.members);
      allow list: if signedIn() && uid() in resource.data.members;
      allow create: if verified()
        && incoming().members.size() == 2
        && uid() in incoming().members
        && incoming().members[0] < incoming().members[1]
        && chatId == incoming().members[0] + '_' + incoming().members[1]
        // Phase 9 size caps: only the app's fields, previews and names of chat size.
        && incoming().keys().hasOnly(['members', 'names', 'photos', 'lastText', 'lastSender', 'lastAt', 'lastMessageId', 'lastDeletedMessageId', 'unread'])
        && incoming().get('names', {}).keys().hasOnly(incoming().members)
        && incoming().get('photos', {}).keys().hasOnly(incoming().members)
        && incoming().get('unread', {}).keys().hasOnly(incoming().members)
        && incoming().get('lastText', '') == '' && incoming().get('lastSender', '') == ''
        && incoming().get('lastMessageId', '') == ''
        && namesAuthentic(incoming());
      allow update: if signedIn() && uid() in resource.data.members
        && onlyChanging(['lastText', 'lastSender', 'lastAt', 'lastMessageId', 'lastDeletedMessageId', 'unread', 'names', 'photos'])
        && chatUpdateOk(changed(), incoming(), resource.data);
      allow delete: if isAdmin();

      // Phase 9: a member changes only their own name and photo, and previews stay short. Account deletion blanks the
      // name, photo and preview. (No time gap between messages: messages written offline are sent back to back when
      // the phone reconnects, and a gap would silently drop them; see docs/security/ABUSE_LIMITS.md.)
      function namesAuthentic(d) {
        return d.names.get(d.members[0], '') == get(/databases/$(database)/documents/users/$(d.members[0])).data.username
          && d.names.get(d.members[1], '') == get(/databases/$(database)/documents/users/$(d.members[1])).data.username
          && d.photos.get(d.members[0], '') == get(/databases/$(database)/documents/users/$(d.members[0])).data.get('photoId', '')
          && d.photos.get(d.members[1], '') == get(/databases/$(database)/documents/users/$(d.members[1])).data.get('photoId', '');
      }
      function previewOf(m) {
        return m.text != '' ? m.text[0:(m.text.size() < 120 ? m.text.size() : 120)] : m.get('imageId', '') != '' ? 'Photo'
          : m.get('matchId', '') != '' ? ('Possible match: ' + m.get('postTitle', '')).trim() : 'Post: ' + m.get('postTitle', '');
      }
      function previewMatches(d) {
        let m = getAfter(/databases/$(database)/documents/chats/$(chatId)/messages/$(d.lastMessageId)).data;
        return d.lastSender == m.senderId && d.lastAt == m.createdAt && d.lastText == previewOf(m);
      }
      function coherentPreview(d, before) {
        let removed = d.get('lastDeletedMessageId', '');
        let oldPath = /databases/$(database)/documents/chats/$(chatId)/messages/$(removed);
        let repairing = removed != '' && exists(oldPath) && get(oldPath).data.senderId == uid()
          && !existsAfter(oldPath) && (before.get('lastMessageId', '') == removed
            || (before.get('lastMessageId', '') == '' && before.lastSender == uid() && before.lastAt == get(oldPath).data.createdAt));
        return (repairing && (d.get('lastMessageId', '') == ''
            ? d.lastText == '' && d.lastSender == '' && d.lastAt == 0 : previewMatches(d)))
          || (d.get('lastMessageId', '') != '' && d.lastSender == uid() && previewMatches(d)
            && !exists(/databases/$(database)/documents/chats/$(chatId)/messages/$(d.lastMessageId)))
          || (before.lastSender == uid() && d.lastSender == '' && d.lastText == '' && d.get('lastMessageId', '') == ''
            && d.lastAt in [0, before.lastAt]);
      }

      function unreadOk(d, before) {
        let other = before.members[0] == uid() ? before.members[1] : before.members[0];
        return d.unread.keys().hasOnly(before.members) && d.unread[uid()] is int && d.unread[uid()] >= 0
          && (d.unread[uid()] == before.unread[uid()] || (d.unread[uid()] == 0
            && getAfter(/databases/$(database)/documents/userLimits/$(uid())).data.unreadChatId == chatId
            && getAfter(/databases/$(database)/documents/userLimits/$(uid())).data.unreadCount == get(/databases/$(database)/documents/userLimits/$(uid())).data.unreadCount - before.unread[uid()]))
          && d.unread[other] is int && d.unread[other] >= 0
          && (d.unread[other] == before.unread[other] || (d.unread[other] == before.unread[other] + 1
            && d.lastSender == uid() && !exists(/databases/$(database)/documents/chats/$(chatId)/messages/$(d.lastMessageId))
            && existsAfter(/databases/$(database)/documents/chats/$(chatId)/messages/$(d.lastMessageId))));
      }
      function chatUpdateOk(ch, d, before) {
        return optStr(d, 'lastMessageId', 128) && optStr(d, 'lastDeletedMessageId', 128)
          && (!('lastText' in ch) || (d.lastText is string && d.lastText.size() <= 300))
          && (!ch.hasAny(['lastText','lastSender','lastAt','lastMessageId']) || coherentPreview(d, before))
          && (!('lastAt' in ch) || notFuture(d.lastAt))
          && (!('names' in ch) || (d.names.diff(before.get('names', {})).affectedKeys().hasOnly([uid()])
              && d.names.get(uid(), '') in ['', get(userPath()).data.username]))
          && (!('photos' in ch) || (d.photos.diff(before.get('photos', {})).affectedKeys().hasOnly([uid()])
              && d.photos.get(uid(), '') is string && d.photos.get(uid(), '').size() <= 128))
          && (!('unread' in ch) || unreadOk(d, before));
      }

      match /messages/{messageId} {
        function chat() { return get(/databases/$(database)/documents/chats/$(chatId)).data; }
        function otherMember() { return chat().members[0] == uid() ? chat().members[1] : chat().members[0]; }
        allow read: if maintenanceWorker() || (signedIn() && uid() in chat().members);
        // Nobody can message a person who has blocked them.
        allow create: if verified()
          && incoming().senderId == uid()
          && uid() in chat().members
          && getAfter(/databases/$(database)/documents/chats/$(chatId)).data.lastMessageId == messageId
          && getAfter(/databases/$(database)/documents/userLimits/$(otherMember())).data.unreadMessageId == messageId
          && getAfter(/databases/$(database)/documents/userLimits/$(otherMember())).data.unreadChatId == chatId
          && getAfter(/databases/$(database)/documents/userLimits/$(otherMember())).data.unreadCount == get(/databases/$(database)/documents/userLimits/$(otherMember())).data.unreadCount + 1
          && incoming().keys().hasOnly(['senderId', 'text', 'imageId', 'postId', 'postTitle', 'postPhotoId', 'matchId', 'matchPhotoId', 'createdAt'])
          && incoming().text.size() <= 2000
          && optStr(incoming(), 'imageId', 128) && optStr(incoming(), 'postId', 128) && optStr(incoming(), 'postTitle', 80)
          && optStr(incoming(), 'postPhotoId', 128) && optStr(incoming(), 'matchId', 300) && optStr(incoming(), 'matchPhotoId', 128)
          && communityPhoto(incoming().get('postPhotoId', '')) && communityPhoto(incoming().get('matchPhotoId', ''))
          && (incoming().get('imageId', '') == '' || (incoming().imageId.matches('c_.*')
            && getAfter(/databases/$(database)/documents/images/$(incoming().imageId)).data.chatId == chatId
            && getAfter(/databases/$(database)/documents/images/$(incoming().imageId)).data.ownerId == uid()
            && getAfter(/databases/$(database)/documents/images/$(incoming().imageId)).data.messageId == messageId))
          && notFuture(incoming().get('createdAt', 0))
          && !exists(/databases/$(database)/documents/users/$(otherMember())/blocked/$(uid()))
          && !exists(/databases/$(database)/documents/accountDeletions/$(otherMember()));
        allow delete: if signedIn() && (resource.data.senderId == uid() || isAdmin());
      }
    }

    // ---------- CatMap AI server (the cat-server folder on the owner's PC) ----------
    // The PC signs in as the AI worker account (custom claim catmapAiWorker, set only by auth:import).
    function aiWorker() { return signedIn() && request.auth.token.get('catmapAiWorker', false) == true; }

    // Heartbeat: the worker says it's online, so phones skip the check at once when the PC is off.
    match /config/aiWorker {
      allow read: if member();
      allow write: if aiWorker()
        && request.resource.data.keys().hasOnly(['online', 'lastSeen', 'model', 'provider', 'same', 'maybe', 'capabilities'])
        && request.resource.data.online is bool && request.resource.data.lastSeen is timestamp
        // Job kinds this PC answers beyond the original three (photo review: 'review-v1'); apps check before sending.
        && request.resource.data.get('capabilities', []) is list && request.resource.data.get('capabilities', []).size() <= 8;
    }

    // One job per user (document id = uid): crops of a new street animal and of nearby posts, photos to embed for
    // the Recognition test, or a new post's photos to check ("is it an animal?", plus the nearby comparison).
    // The owner writes it; the worker reads it and may only write the result fields.
    match /aiJobs/{ownerId} {
      allow read: if signedIn() && (uid() == ownerId || aiWorker());
      allow create, update: if verified() && uid() == ownerId
        && incoming().keys().hasOnly(['uid', 'kind', 'status', 'query', 'images', 'ids', 'labels', 'photos', 'requestId', 'createdAt'])
        && incoming().uid == ownerId && incoming().status == 'pending'
        && incoming().kind in ['compare', 'embed', 'check', 'review']
        // Photo review (docs/MATCHING_REVIEW_V1.md): one photo and 1-8 cat ids; the PC reads the cats' photos itself.
        && (incoming().kind != 'review' || (incoming().images.size() == 0 && incoming().get('photos', []).size() == 0
          && incoming().ids.size() >= 1 && incoming().ids.size() <= 8 && incoming().get('query', null) is bytes))
        && incoming().images is list && incoming().images.size() <= 16
        && incoming().ids is list && incoming().ids.size() <= 16
        && incoming().get('labels', []).size() <= 16
        && incoming().get('photos', []) is list && incoming().get('photos', []).size() <= 6
        && (!('query' in incoming()) || (incoming().query is bytes && incoming().query.size() <= 150000))
        && incoming().requestId is string && incoming().requestId.size() <= 64
        && incoming().createdAt == request.time
        // At most one new job a second per person.
        && (resource == null || request.time > resource.data.createdAt + duration.value(1, 's'));
      allow update: if aiWorker()
        && changed().hasOnly(['status', 'results', 'embeddings', 'classification', 'review', 'model', 'provider', 'ms', 'error', 'doneAt', 'answeredRequestId'])
        && incoming().status in ['done', 'error'];
      // Phase 9: the phone removes its job once answered, or after its 15 s wait. Deleting a pending job sooner would
      // let a script skip the one-second gap above by deleting and re-creating (v0.0.9 never deletes).
      allow delete: if aiWorker() || (signedIn() && uid() == ownerId
        && (resource.data.status != 'pending' || request.time > resource.data.createdAt + duration.value(10, 's')));
    }

    // ---------- lost report <-> sighting matches (see docs/MATCHING.md) ----------
    // One document per pair, id "{lostPostId}__{sightingPostId}", so a pair can't be suggested twice. Only the two
    // people involved (and moderators, and the AI worker) can see it. The AI worker writes the scores from the photo
    // model; a phone writes them from its colour fingerprint while the PC is off and can never claim "strong". Only
    // the owner answers for the lost animal, only the reporter for their sighting, and nobody can merge or close
    // anything through a match.
    function postAt(id) { return get(/databases/$(database)/documents/posts/$(id)).data; }
    function postAfter(id) { return getAfter(/databases/$(database)/documents/posts/$(id)).data; }
    function validMatchScores(d) {
      return d.score is number && d.score >= 0 && d.score <= 1
        && d.visual is number && d.visual >= -1 && d.visual <= 1
        && d.tier in ['strong', 'possible', 'weak', 'none']
        && d.method in ['embedding', 'fingerprint', 'details']
        && d.model is string && d.model.size() <= 80
        && d.distanceKm is number && d.distanceKm >= 0
        && d.daysApart is number
        && d.reasons is list && d.reasons.size() <= 10
        && d.source in ['worker', 'device']
        && d.updatedAt is int;
    }
    match /matches/{matchId} {
      allow get: if signedIn() && (resource == null || uid() in resource.data.members || isMod() || aiWorker());
      allow list: if signedIn() && (uid() in resource.data.members || isMod() || aiWorker());
      allow create: if incoming().keys().hasOnly(['lostPostId', 'sightingPostId', 'lostOwnerId', 'sightingOwnerId', 'members',
            'animalType', 'score', 'visual', 'tier', 'method', 'model', 'distanceKm', 'daysApart', 'reasons', 'source',
            'ownerState', 'reporterState', 'createdBy', 'createdAt', 'updatedAt', 'notified'])
        && matchId == incoming().lostPostId + '__' + incoming().sightingPostId
        && incoming().members == [incoming().lostOwnerId, incoming().sightingOwnerId]
        && incoming().lostOwnerId != incoming().sightingOwnerId
        && postAt(incoming().lostPostId).ownerId == incoming().lostOwnerId
        && postAt(incoming().lostPostId).category == 'lost'
        && postAt(incoming().sightingPostId).ownerId == incoming().sightingOwnerId
        && postAt(incoming().sightingPostId).category in ['found', 'spotted', 'street']
        && postAt(incoming().lostPostId).animalType == incoming().animalType
        && postAt(incoming().sightingPostId).animalType == incoming().animalType
        && incoming().ownerState == 'new' && incoming().notified is bool && incoming().createdAt is int
        && validMatchScores(incoming())
        && ((aiWorker() && incoming().source == 'worker' && incoming().createdBy == 'worker' && incoming().reporterState == 'new')
          || (verified() && uid() in incoming().members && incoming().createdBy == uid() && incoming().source == 'device'
              && incoming().method in ['fingerprint', 'details'] && incoming().tier in ['possible', 'weak', 'none']
              // The person who saw the animal may link their sighting to the report themselves.
              && (incoming().reporterState == 'new' || (incoming().reporterState == 'confirmed' && uid() == incoming().sightingOwnerId))));
      allow update: if
        // The owner's answer. "reunited" only together with marking this report reunited through this match.
        (verified() && uid() == resource.data.lostOwnerId
          && onlyChanging(['ownerState', 'reviewedAt', 'updatedAt'])
          && incoming().ownerState in ['new', 'maybe', 'not_mine', 'need_info', 'reunited']
          && (incoming().ownerState != 'reunited'
              || (postAfter(resource.data.lostPostId).status == 'reunited' && postAfter(resource.data.lostPostId).get('resolvedMatchId', '') == matchId)))
        // The reporter's answer about their own sighting.
        || (verified() && uid() == resource.data.sightingOwnerId
          && onlyChanging(['reporterState', 'updatedAt'])
          && incoming().reporterState in ['new', 'confirmed', 'not_same'])
        // The AI worker re-scores, but never touches people's answers and never revives a rejected pair.
        || (aiWorker() && onlyChanging(['score', 'visual', 'tier', 'method', 'model', 'distanceKm', 'daysApart', 'reasons', 'source', 'updatedAt', 'notified'])
          && resource.data.ownerState != 'not_mine' && incoming().source == 'worker' && validMatchScores(incoming()))
        // A moderator can record that a reunion was checked independently.
        || (isMod() && onlyChanging(['verifiedBy', 'verifiedAt']) && incoming().verifiedBy in ['', uid()] && incoming().verifiedAt is int);
      // Kept while both posts exist, so a rejected pair is remembered; cleaned up after either post is deleted.
      allow delete: if isAdmin() || (signedIn() && uid() in resource.data.members
        && (!exists(/databases/$(database)/documents/posts/$(resource.data.lostPostId))
            || !exists(/databases/$(database)/documents/posts/$(resource.data.sightingPostId))));
    }

    // The AI worker's photo embeddings of each post (one 512-number vector per photo). Only the worker writes them,
    // so nobody can plant a fake vector to force a match.
    match /postEmbeddings/{postId} {
      allow read: if aiWorker() || isMod();
      allow create, update: if aiWorker() && incoming().postId == postId && !deletingPost(postId)
        && postAt(postId).ownerId == incoming().ownerId && postAt(postId).photoIds == incoming().photoIds
        && postAt(postId).hidden == false
        && incoming().keys().hasOnly(['postId', 'ownerId', 'animalType', 'model', 'signature', 'photoIds', 'vectors', 'detected', 'animals', 'lowQuality', 'createdAt'])
        && incoming().vectors is list && incoming().vectors.size() <= 6;
      allow delete: if aiWorker() || isMod()
        || (signedIn() && (!exists(/databases/$(database)/documents/posts/$(postId)) || postAt(postId).ownerId == uid()));
    }

    match /helpDirectory/{contactId} {
      allow read: if true;
      allow create, update: if isAdmin()
        && incoming().keys().hasOnly(['name','kind','phone','address','website','note','demo','updatedAt'])
        && incoming().name is string && incoming().name.size() > 0 && incoming().name.size() <= 80
        && incoming().kind in ['vet','shelter','emergency','other']
        && incoming().phone is string && incoming().phone.size() <= 40
        && incoming().address is string && incoming().address.size() <= 300
        && incoming().website is string && incoming().website.size() <= 300
        && (incoming().website == '' || incoming().website.matches('https://.*'))
        && incoming().note is string && incoming().note.size() <= 600
        && incoming().demo is bool && incoming().updatedAt is int;
      allow delete: if isAdmin();
    }

    // ---------- photos (JPEG blobs, EXIF already stripped on the phone) ----------
    match /images/{imageId} {
      // Photos are fetched one by one by id. Listing them is only for your own (account deletion and export) or for
      // moderators, so nobody can page through every photo in the app.
      allow get: if member() && (resource == null || resource.data.get('audience', '') == 'community'
          || resource.data.ownerId == uid() || maintenanceWorker() || privateImageMember(resource.data));
      allow list: if (signedIn() && resource.data.ownerId == uid()) || isMod();
      // JPEG only (both apps re-encode every photo, which also drops its location data), a thumbnail (`{id}_t`, 360
      // px) at most 200 KB and a full photo under 1 MB.
      allow create: if verified()
        && incoming().keys().hasOnly(['data', 'ownerId', 'createdAt', 'audience', 'chatId', 'rootId', 'messageId'])
        && incoming().ownerId == uid() && incoming().messageId == ''
        && incoming().rootId is string && incoming().rootId.size() <= 128
        && imageId in [incoming().rootId, incoming().rootId + '_t']
        && getAfter(/databases/$(database)/documents/mediaUploads/$(incoming().rootId)).data.ownerId == uid()
        && getAfter(/databases/$(database)/documents/mediaUploads/$(incoming().rootId)).data.audience == incoming().audience
        && getAfter(/databases/$(database)/documents/mediaUploads/$(incoming().rootId)).data.chatId == incoming().chatId
        && getAfter(/databases/$(database)/documents/mediaUploads/$(incoming().rootId)).data.status == 'staged'
        && getAfter(/databases/$(database)/documents/mediaUploads/$(incoming().rootId)).data.expiresAt > request.time.toMillis()
        && ((incoming().audience == 'community' && incoming().chatId == '' && !imageId.matches('c_.*'))
          || (incoming().audience == 'chat' && imageId.matches('c_.*') && privateImageAudience(incoming())))
        && incoming().data is bytes
        && incoming().data.size() < (imageId.matches('.+_t') ? 200000 : 1000000)
        && incoming().data.toHexString().matches('(FFD8FF|ffd8ff).*')
        && notFuture(incoming().get('createdAt', 0));
      allow delete: if signedIn() && (resource == null || resource.data.ownerId == uid() || isMod() || maintenanceWorker());
      allow update: if verified() && resource.data.ownerId == uid() && resource.data.audience == 'chat'
        && resource.data.get('messageId', '') == '' && onlyChanging(['messageId'])
        && incoming().messageId is string && incoming().messageId.size() <= 128
        && getAfter(/databases/$(database)/documents/chats/$(resource.data.chatId)/messages/$(incoming().messageId)).data.senderId == uid()
        && getAfter(/databases/$(database)/documents/chats/$(resource.data.chatId)/messages/$(incoming().messageId)).data.imageId == resource.data.rootId;
      function privateImageMember(d) {
        return privateImageAudience(d) && d.get('messageId', '') != ''
          && get(/databases/$(database)/documents/chats/$(d.chatId)/messages/$(d.messageId)).data.imageId == d.rootId;
      }
      function privateImageAudience(d) {
        let c = get(/databases/$(database)/documents/chats/$(d.chatId)).data;
        let other = c.members[0] == uid() ? c.members[1] : c.members[0];
        return d.get('audience', '') == 'chat' && uid() in c.members
          && !exists(/databases/$(database)/documents/users/$(other)/blocked/$(uid()))
          && !exists(/databases/$(database)/documents/users/$(uid())/blocked/$(other));
      }
    }
  }
}
